---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter((p) => p !== featuredPost).slice(0, 6);

const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
const healthCheckLink = 'https://nomadtaxhelp.com/health-check';

// Homepage JSON-LD: WebSite + Blog + Person.
// (Sitewide Organization schema is emitted separately by BaseLayout.)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://blog.nomadtaxhelp.com/#website',
      url: 'https://blog.nomadtaxhelp.com',
      name: 'NomadTaxHelp Blog',
      description: 'Practical guides on tax residency for European and rest-of-world digital nomads.',
      inLanguage: 'en',
      publisher: { '@id': 'https://nomadtaxhelp.com/#organization' },
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: 'https://blog.nomadtaxhelp.com/posts?q={search_term_string}',
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Blog',
      '@id': 'https://blog.nomadtaxhelp.com/#blog',
      url: 'https://blog.nomadtaxhelp.com',
      name: 'NomadTaxHelp Blog',
      description: 'Practical guides on tax residency, Paraguay setup, US LLCs, and tax exit strategy for European and rest-of-world digital nomads.',
      author: { '@id': 'https://blog.nomadtaxhelp.com/about#felix' },
      publisher: { '@id': 'https://nomadtaxhelp.com/#organization' },
      inLanguage: 'en',
    },
    {
      '@type': 'Person',
      '@id': 'https://blog.nomadtaxhelp.com/about#felix',
      name: 'Felix Yanez-Bowker',
      url: 'https://blog.nomadtaxhelp.com/about',
      image: 'https://blog.nomadtaxhelp.com/images/felix.jpg',
      jobTitle: 'Co-Founder, NomadTaxHelp',
      sameAs: [
        'https://www.linkedin.com/in/felix-yanez-bowker-b23270252/',
        'https://felixyanez.substack.com/',
        'https://fascinated-princess-801.notion.site/About-Me-54522f72ef6a470aa87711bb889cd30c',
        'https://nomadtaxhelp.com',
      ],
    },
  ],
};
---

<BaseLayout
  title="NomadTaxHelp Blog | Practical guides for nomads sorting their tax setup"
  description="Practical guides on tax residency, US LLCs, and international tax exits for digital nomads and remote entrepreneurs. Written by Felix Yanez-Bowker, co-founder of NomadTaxHelp."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="bg-cream-100 py-16 sm:py-24 px-4">
    <div class="max-w-[680px] mx-auto text-center">
      <h1 class="font-heading font-bold text-teal-900 mb-5 no-underline" style="font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.15; letter-spacing: -0.02em; text-decoration: none;">
        Practical Guides for Nomads Sorting Their Tax Setup
      </h1>
      <p class="font-body text-gray-600 mb-8 max-w-lg mx-auto" style="font-size: 1.0625rem; line-height: 1.6; font-weight: 400;">
        Written by Felix, co-founder of NomadTaxHelp. No jargon, no hype, no tax-adviser disclaimers written by lawyers. Just what actually works.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href={calLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-3.5 rounded-lg bg-amber-600 text-white font-heading font-semibold no-underline hover:bg-amber-700 transition-[background-color] duration-200"
        >
          Book a Call
        </a>
        <a
          href={healthCheckLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-3.5 rounded-lg border-2 border-teal-900 text-teal-900 font-heading font-semibold no-underline hover:bg-teal-900 hover:text-white transition-colors duration-200"
        >
          Take the Health Check
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Featured post -->
    {featuredPost && (
      <section class="mb-12">
        <a
          href={`/posts/${featuredPost.data.slug}`}
          class="block bg-white rounded-xl border border-gray-200 shadow-sm no-underline overflow-hidden group hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
        >
          <div class="p-6 sm:p-8">
            <h2 class="font-heading text-gray-900 mb-3 group-hover:text-teal-900 transition-colors duration-200" style="font-size: 1.375rem; font-weight: 600;">
              {featuredPost.data.title}
            </h2>
            <p class="font-body text-gray-600 mb-4 max-w-2xl" style="font-weight: 400;">
              {featuredPost.data.description}
            </p>
            <div class="flex items-center gap-3 font-heading" style="font-size: 0.8125rem; font-weight: 400; color: #6b7280;">
              <span>Felix Yanez-Bowker</span>
              <span>&middot;</span>
              <time datetime={featuredPost.data.publishDate.toISOString()}>
                {featuredPost.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              {featuredPost.data.readingTime && (
                <>
                  <span>&middot;</span>
                  <span>{featuredPost.data.readingTime} min read</span>
                </>
              )}
            </div>
          </div>
        </a>
      </section>
    )}

    <!-- Recent posts grid -->
    {recentPosts.length > 0 && (
      <section class="mb-16">
        <h2 class="font-heading text-xl font-semibold text-teal-900 mb-6">Recent posts</h2>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <a
              href={`/posts/${post.data.slug}`}
              class="block bg-white rounded-xl border border-gray-200 shadow-sm no-underline group p-5 hover:-translate-y-0.5 hover:shadow-md transition-all duration-200"
            >
              <h3 class="font-heading font-semibold text-gray-900 text-lg mb-2 group-hover:text-teal-900 transition-colors duration-200">
                {post.data.title}
              </h3>
              <p class="text-sm text-gray-600 line-clamp-2 mb-3 font-body">{post.data.description}</p>
              <time class="text-xs text-gray-600 font-heading" style="color: #6b7280;" datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Book a Call CTA (replaces newsletter signup) -->
    <section class="bg-teal-900 rounded-xl px-6 sm:px-8 text-center" style="padding-top: 80px; padding-bottom: 80px;">
      <h2 class="font-heading font-bold text-white mb-3" style="font-size: 1.75rem;">
        Ready to Sort Your Tax Setup?
      </h2>
      <p class="font-body text-cream-100 mb-6 mx-auto" style="font-weight: 400; font-size: 1.0625rem; max-width: 520px;">
        Book a free 20-minute clarity call. I'll map your situation, flag the risks, and give you a one-page plan to act on.
      </p>
      <a
        href={calLink}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center bg-amber-600 text-white font-heading font-semibold no-underline hover:bg-amber-700 transition-[background-color] duration-200"
        style="padding: 14px 32px; border-radius: 8px;"
      >
        Book a Call &rarr;
      </a>
    </section>
  </div>
</BaseLayout>
