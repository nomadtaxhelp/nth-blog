---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
;

const now = new Date();
const fourteenDaysAgo = new Date(now.getTime() - 14 * 24 * 60 * 60 * 1000);

const calLink = 'https://nomadtaxhelp.com/application';
const latestDate = sortedPosts[0]?.data.publishDate || new Date();

// Homepage JSON-LD: Blog + Person. Sitewide
// Organization schema is emitted separately by BaseLayout.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [

    {
      '@type': 'Blog',
      '@id': 'https://nomadtaxhelp.com/blog/#blog',
      url: 'https://nomadtaxhelp.com/blog',
      name: 'NomadTaxHelp Blog',
      description: 'Practical guides on tax residency, Paraguay setup, US LLCs, and tax exit strategy for European and rest-of-world digital nomads.',
      author: [{ '@id': 'https://nomadtaxhelp.com/blog/about#felix' }, { '@id': 'https://nomadtaxhelp.com/#organization' }],
      publisher: { '@id': 'https://nomadtaxhelp.com/#organization' },
      inLanguage: 'en',
      dateModified: latestDate.toISOString(),
      datePublished: '2026-04-16T00:00:00.000Z',
      blogPost: sortedPosts.map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        url: `https://nomadtaxhelp.com/blog/posts/${p.data.slug}`,
        datePublished: p.data.publishDate.toISOString(),
        dateModified: (p.data.updatedDate || p.data.publishDate).toISOString(),
        author: { '@id': p.data.author === 'nth' ? 'https://nomadtaxhelp.com/#organization' : 'https://nomadtaxhelp.com/blog/about#felix' },
        description: p.data.description,
      })),
    },
    {
      '@type': 'Person',
      '@id': 'https://nomadtaxhelp.com/blog/about#felix',
      name: 'Felix Yanez-Bowker',
      url: 'https://nomadtaxhelp.com/blog/about',
      image: 'https://nomadtaxhelp.com/blog/images/felix.png',
      jobTitle: 'Co-Founder, NomadTaxHelp',
      sameAs: [
        'https://www.linkedin.com/in/felix-yanez-bowker-b23270252/',
        'https://felixyanez.substack.com/',
        'https://fascinated-princess-801.notion.site/About-Me-54522f72ef6a470aa87711bb889cd30c',
        'https://nomadtaxhelp.com',
      ],
    },

  ],
};

const featured = sortedPosts.find(p => p.data.slug.includes('requirements')) || sortedPosts[0];
const category = (p: typeof sortedPosts[number]) => /bank|llc|crypto/.test(p.data.slug) ? 'Money & business' : /dubai|portugal|europe/.test(p.data.slug) ? 'Comparisons & tax exit' : 'Paraguay residency';
---

<BaseLayout editorial title="Paraguay Residency & Tax Guides | Nomad Tax Help" description="Understand Paraguay residency, banking, tax and your options abroad. Practical guides from Felix and the Nomad Tax Help team." jsonLd={jsonLd}>
 <Fragment slot="head"><link rel="stylesheet" href="/blog/library.css" /></Fragment>
 <header class="library-header"><a class="library-brand" href="/">Nomad Tax Help<span>RESIDENCY · TAX · FREEDOM</span></a><nav aria-label="Main navigation"><a href="/">Home</a><a href="#guides" aria-current="page">Guides</a><a href="/blog/about">Our team</a><a class="library-button" href={calLink}>Apply for our services <span aria-hidden="true">↗</span></a></nav></header>
 <div class="library-main">
  <section class="library-hero"><div><p class="library-eyebrow">THE NOMAD TAX HELP LIBRARY</p><h1>A clearer path to<br /><em>your life abroad.</em></h1><p class="library-intro">Paraguay residency. Your tax position. A setup that works together. Get the information to make your next move with confidence.</p><a class="library-text-link" href="#guides">Explore the guides <span aria-hidden="true">↓</span></a></div><aside class="library-feature"><img src="/blog/images/library-asuncion.webp" alt="Asunción skyline at dusk beside the Paraguay River" width="800" height="533" fetchpriority="high" /><div><span class="library-eyebrow">START HERE · PARAGUAY RESIDENCY</span><h2><a href={`/blog/posts/${featured.data.slug}`}>{featured.data.title}</a></h2><a class="library-text-link" href={`/blog/posts/${featured.data.slug}`}>Read the guide <span aria-hidden="true">↗</span></a></div></aside></section>
  <div class="library-editor"><img src="/blog/images/felix.png" alt="Felix Yanez-Bowker" width="48" height="48" loading="lazy" /><p><strong>From Felix & the Nomad Tax Help team</strong><span>Practical explanations. Official sources linked. Clear next steps.</span></p><a href="/blog/about">Meet the team <span aria-hidden="true">↗</span></a></div>
  <section id="guides" class="library-guides"><div class="library-section-heading"><div><p class="library-eyebrow">MAKE AN INFORMED MOVE</p><h2>Start with your question.</h2></div><label class="library-search"><span class="sr-only">Search guides</span><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg><input id="guide-search" type="search" placeholder="Search residency, banking, tax…" /></label></div>
   <div class="library-filters" role="group" aria-label="Filter guides">{['All guides','Paraguay residency','Money & business','Comparisons & tax exit'].map((label,i)=><button type="button" data-filter={label} aria-pressed={i===0}>{label}</button>)}</div>
   <p id="guide-count" class="library-count" aria-live="polite">{sortedPosts.length} guides</p>
   <div class="library-grid">{sortedPosts.map((post,i)=><article class="library-guide" data-category={category(post)} data-search={`${post.data.title} ${post.data.description}`.toLowerCase()}><div class="library-guide-top"><span>{category(post)}</span><span aria-hidden="true">{String(i+1).padStart(2,'0')}</span></div><h3><a href={`/blog/posts/${post.data.slug}`}>{post.data.title}</a></h3><p>{post.data.description}</p><div class="library-guide-bottom"><span>Updated {new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'}).format(post.data.updatedDate||post.data.publishDate)}</span><a href={`/blog/posts/${post.data.slug}`} aria-label={`Read ${post.data.title}`}><span aria-hidden="true">↗</span></a></div></article>)}</div>
   <p id="guide-empty" hidden>No matching guides. Try “residency”, “banking” or “tax”.</p>
  </section>
  <section class="library-service"><div><p class="library-eyebrow">FROM RESEARCH TO REALITY</p><h2>Have our team handle<br /><em>your Paraguay setup.</em></h2><p>Ready for help with the next step? Apply for our done-for-you services so we can understand your situation.</p></div><a class="library-button" href={calLink}>Apply for our services <span aria-hidden="true">↗</span></a></section>
 </div>
 <footer class="library-footer"><div><a class="library-brand" href="/">Nomad Tax Help</a><nav aria-label="Footer navigation"><a href="/blog/about">About</a><a href="/blog/faq">Common questions</a><a href="/blog/glossary">Glossary</a><a href="mailto:hello@nomadtaxhelp.com">Contact</a></nav></div><p>Nomad Tax Help is a facilitator, not a law firm or tax adviser. We coordinate with licensed partners who are.</p><small>© {new Date().getFullYear()} Nomad Tax Help. All rights reserved.</small></footer>
</BaseLayout>
<script>
 const input = document.querySelector<HTMLInputElement>('#guide-search');
 const cards = [...document.querySelectorAll<HTMLElement>('.library-guide')];
 const filters = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
 let selected = 'All guides';
 function updateGuides() {
  const query = (input?.value || '').trim().toLowerCase();
  let count = 0;
  cards.forEach(card => {const show = (selected === 'All guides' || card.dataset.category === selected) && (card.dataset.search || '').includes(query);card.hidden = !show;if(show) count++;});
  const label=document.querySelector('#guide-count');if(label) label.textContent=`${count} ${count===1?'guide':'guides'}`;
  const empty=document.querySelector<HTMLElement>('#guide-empty');if(empty) empty.hidden=count>0;
 }
 input?.addEventListener('input',updateGuides);
 filters.forEach(button=>button.addEventListener('click',()=>{selected=button.dataset.filter||'All guides';filters.forEach(item=>item.setAttribute('aria-pressed',String(item===button)));updateGuides();}));
</script>
