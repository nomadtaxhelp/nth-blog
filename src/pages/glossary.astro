---
import BaseLayout from '../components/layout/BaseLayout.astro';

// Canonical glossary of every tax-residency term used across the blog.
// Two purposes:
//   1. Internal linking target. Posts link first usage of each term here
//      to build a tight topical link graph.
//   2. AEO entity layer. The DefinedTermSet schema makes each definition
//      a structured entity that LLMs can cite as a primary source.

const terms = [
  // Paraguay-specific
  {
    id: 'trc',
    name: 'TRC (Tax Residency Certificate)',
    section: 'Paraguay',
    definition:
      "A fiscal residence certificate issued through DNIT under the relevant procedure. General Resolution 65/2020 provides one-year validity from issuance. The certified period and the recipient’s requirements matter; it is distinct from an immigration permit.",
    seeAlso: { url: '/blog/posts/paraguay-tax-residency-guide', label: 'Paraguay tax residency guide' },
  },
  {
    id: 'ruc',
    name: 'RUC (Registro Único del Contribuyente)',
    section: 'Paraguay',
    definition:
      "Registro Único de Contribuyentes, Paraguay’s taxpayer register. Registration identifies the taxpayer and applicable obligations. It is not itself a fiscal residence certificate or a blanket tax exemption.",
    seeAlso: { url: '/blog/posts/paraguay-tax-residency-guide', label: 'Paraguay tax residency guide' },
  },
  {
    id: 'cedula',
    name: 'Cédula',
    section: 'Paraguay',
    definition:
      'Paraguay national identity card. Issued after the residency application is approved and biometrics are taken. Your local proof of identity for banking, leases, contracts, and tax filings.',
  },
  {
    id: 'territorial-taxation',
    name: 'Territorial taxation',
    section: 'Paraguay',
    definition:
      "An approach that taxes income according to its source. Paraguay’s personal-income rules require classification under domestic law; a foreign client or foreign bank does not by itself make income foreign-source. Company rules require separate review.",
    seeAlso: { url: '/blog/posts/paraguay-tax-residency-guide', label: 'Paraguay tax residency guide' },
  },
  {
    id: 'paraguay-residency-types',
    name: 'Paraguay temporary vs permanent residency',
    section: 'Paraguay',
    definition:
      "The ordinary route begins with temporary residence, valid for up to two years, followed by a separate permanent application. Immigration absence rules and document expiry dates are distinct from fiscal residence and tax obligations.",
  },

  // Tax exit & residency tests
  {
    id: 'uk-srt',
    name: 'UK SRT (Statutory Residence Test)',
    section: 'Tax exit tests',
    definition:
      "The UK's framework (in force since 6 April 2013) for determining tax residency. Combines automatic non-resident tests (e.g. fewer than 16 days in the UK if you were resident any of the prior 3 years) with the \"sufficient ties\" test counting UK home, family, accommodation, 40-day work, and 90+-day patterns. Specific, mechanical, and well-litigated.",
    seeAlso: { url: '/blog/posts/european-nomad-tax-playbook', label: 'European nomad tax playbook' },
  },
  {
    id: 'wegzugsteuer',
    name: 'Wegzugsteuer (German exit tax)',
    section: 'Tax exit tests',
    definition:
      "German exit tax. It can apply to qualifying ownership interests when statutory conditions are met. An adviser must review the holdings, residence history and proposed move rather than assuming every departure triggers the same charge.",
    seeAlso: { url: '/blog/posts/european-nomad-tax-playbook', label: 'European nomad tax playbook' },
  },
  {
    id: 'renta-mundial',
    name: 'Renta mundial',
    section: 'Tax exit tests',
    definition:
      'Spanish principle that tax residents are taxed on worldwide income, not just income earned in Spain. Combined with Beckham Law restrictions and Modelo 720 reporting, the Spanish exit framework is one of the more onerous in Europe.',
    seeAlso: { url: '/blog/posts/european-nomad-tax-playbook', label: 'European nomad tax playbook' },
  },
  {
    id: 'beckham-law',
    name: 'Beckham Law (Régimen Especial de Trabajadores Desplazados)',
    section: 'Tax exit tests',
    definition:
      "Spain’s special tax regime for qualifying people moving to Spain. Eligibility, covered income and applicable rates require a current individual review; it is not a blanket low rate for every new resident.",
  },
  {
    id: 'day-count-test',
    name: 'Day-count test (183-day rule)',
    section: 'Tax exit tests',
    definition:
      'Common shorthand for the 183-day rule that many countries use as one (not the only) test of tax residency. Spending 183+ days in country X usually triggers residency in X. Falling under doesn\'t automatically make you non-resident; countries also look at family, home, business control, and centre of vital interests.',
  },
  {
    id: 'centre-of-vital-interests',
    name: 'Centro de intereses vitales (centre of vital interests)',
    section: 'Tax exit tests',
    definition:
      'Civil-law concept used in OECD tie-breaker rules to identify the country where your "centre of vital interests" (family, economic activity, social bonds) is located. When two countries both claim you as resident, this is one of the tests used to break the tie.',
  },
  {
    id: 'tie-breaker-rule',
    name: 'OECD tie-breaker rule',
    section: 'Tax exit tests',
    definition:
      "A residence-conflict rule in an applicable bilateral tax treaty. OECD-model provisions often consider permanent home, personal and economic ties, habitual abode and nationality. The actual treaty and eligibility control; not every country pair has one.",
  },
  {
    id: 'dtt',
    name: 'DTT / DTA (Double Tax Treaty)',
    section: 'Tax exit tests',
    definition:
      "A bilateral tax treaty that allocates taxing rights and may provide relief, withholding limits and information-exchange rules. Check whether a relevant treaty exists, covers the person and income, and applies to the period in question.",
  },
  {
    id: 'padron',
    name: 'Padrón (municipal registry)',
    section: 'Tax exit tests',
    definition:
      "Spain's municipal residency registry (Padrón Municipal). Registering or deregistering matters for proving where you actually live. The Spanish tax authority looks at padrón, utility bills and physical presence together, not any single signal.",
  },

  // International compliance
  {
    id: 'crs',
    name: 'OECD CRS (Common Reporting Standard)',
    section: 'International compliance',
    definition:
      "The Common Reporting Standard for automatic financial-account information exchange. The OECD’s May 2026 update says Paraguay is preparing to commence exchanges in 2027. It does not certify an individual tax setup.",
    seeAlso: { url: '/blog/posts/is-paraguay-tax-residency-legit', label: 'Is Paraguay tax residency legit?' },
  },
  {
    id: 'fatca',
    name: 'FATCA',
    section: 'International compliance',
    definition:
      "US-specific reporting framework that requires non-US financial institutions to report on US persons' accounts. Doesn't apply to non-US persons. NomadTaxHelp does not serve US persons.",
  },
  {
    id: 'eu-blacklist',
    name: 'EU non-cooperative jurisdictions list',
    section: 'International compliance',
    definition:
      "The EU list of non-cooperative jurisdictions for tax purposes. It is periodically revised. Check the Council’s current publication; list status does not determine whether a specific person’s tax arrangement is valid.",
    seeAlso: { url: '/blog/posts/is-paraguay-tax-residency-legit', label: 'Is Paraguay tax residency legit?' },
  },
  {
    id: 'fatf',
    name: 'FATF (Financial Action Task Force)',
    section: 'International compliance',
    definition:
      "The Financial Action Task Force sets anti-money-laundering and counter-terrorist-financing standards and publishes jurisdiction monitoring information. Its assessments are distinct from tax-residence rules and bank approval decisions.",
  },
  {
    id: 'apostille',
    name: 'Apostille',
    section: 'International compliance',
    definition:
      'Certified verification of a public document for international use, under the 1961 Hague Convention. Paraguay accepts apostilled documents from any signatory country. NomadTaxHelp-required apostilles: birth certificate, criminal record certificate, marriage or divorce certificate (if applicable).',
  },

  // Other regimes
  {
    id: 'portugal-nhr',
    name: 'NHR (Non-Habitual Resident, Portugal)',
    section: 'Other regimes',
    definition:
      "Portugal’s former Non-Habitual Resident tax regime. Repealed from 1 January 2024 with transitional protections and continuing benefits for eligible existing holders. Treatment depends on the income category and applicable conditions.",
    seeAlso: { url: '/blog/posts/portugal-nhr-replacement-2026', label: 'Portugal NHR and IFICI explained' },
  },
  {
    id: 'ifici',
    name: 'IFICI (Portugal)',
    section: 'Other regimes',
    definition:
      "Portugal’s incentive for scientific research and innovation. It can provide a 20% rate on qualifying Portuguese employment and self-employment income over ten years, with specific eligibility and foreign-income rules.",
    seeAlso: { url: '/blog/posts/portugal-nhr-replacement-2026', label: 'Portugal NHR and IFICI explained' },
  },
  {
    id: 'cyprus-60-day',
    name: 'Cyprus 60-day non-dom',
    section: 'Other regimes',
    definition:
      "Cyprus has a conditional 60-day tax-residence route. Residence and non-dom status are separate concepts. Check the current Tax Department criteria and treatment of each income stream instead of treating 60 days as the only condition.",
    seeAlso: { url: '/blog/posts/portugal-nhr-replacement-2026', label: 'Portugal NHR and IFICI explained' },
  },
  {
    id: 'uae',
    name: 'UAE / Dubai tax',
    section: 'Other regimes',
    definition:
      "The UAE has separate rules for personal tax residence, residence certificates and corporate taxation. Immigration permission and a company licence are not interchangeable with a personal fiscal residence determination.",
  },
];

const sections = Array.from(new Set(terms.map((t) => t.section)));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'DefinedTermSet',
      '@id': 'https://nomadtaxhelp.com/blog/glossary#termset',
      name: 'NomadTaxHelp tax-residency glossary',
      description:
        'Canonical definitions of tax-residency terms used across the NomadTaxHelp blog: TRC, RUC, cédula, territorial taxation, OECD CRS, UK SRT, Wegzugsteuer, NHR, IFICI, and more.',
      url: 'https://nomadtaxhelp.com/blog/glossary',
      inLanguage: 'en',
      hasDefinedTerm: terms.map((t) => ({
        '@type': 'DefinedTerm',
        '@id': `https://nomadtaxhelp.com/blog/glossary#${t.id}`,
        name: t.name,
        description: t.definition,
        url: `https://nomadtaxhelp.com/blog/glossary#${t.id}`,
        inDefinedTermSet: 'https://nomadtaxhelp.com/blog/glossary#termset',
      })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://nomadtaxhelp.com/blog/' },
        { '@type': 'ListItem', position: 2, name: 'Glossary', item: 'https://nomadtaxhelp.com/blog/glossary' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Tax-residency glossary | NomadTaxHelp Blog"
  description="Plain-English definitions of every tax-residency term used across NomadTaxHelp: TRC, RUC, cédula, OECD CRS, UK Statutory Residence Test, Wegzugsteuer, NHR, IFICI, and more."
  jsonLd={jsonLd}
>
  <article class="max-w-[820px] mx-auto px-5 sm:px-8 py-12 sm:py-16">
    <p class="font-heading text-amber-600 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] mb-4">Glossary</p>
    <h1 class="font-heading font-bold text-cream-100 mb-5 text-4xl sm:text-5xl tracking-[-0.01em]">Plain-English tax-residency terms</h1>
    <p class="text-base sm:text-lg text-cream-soft/85 mb-12 max-w-[640px] font-body leading-relaxed">
      Tax residency for nomads has more jargon than it deserves. Here's the plain-English version of every term I use across this blog. Each definition links to the post where it actually matters.
    </p>

    <!-- Big cream card holds all the term definitions for readable scanning -->
    <div class="surface-cream p-6 sm:p-10" style="box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4);">
      {sections.map((section) => (
        <section class="mb-10 last:mb-0">
          <h2 class="font-heading font-bold text-teal-900 text-xl mb-6 pb-2 border-b border-teal-900/15 tracking-[-0.01em]">{section}</h2>
          <dl class="space-y-7">
            {terms
              .filter((t) => t.section === section)
              .map((t) => (
                <div id={t.id} class="scroll-mt-24">
                  <dt class="font-heading font-bold text-teal-900 text-lg mb-2">
                    <a href={`#${t.id}`} class="no-underline hover:text-amber-700 transition-colors">
                      {t.name}
                    </a>
                  </dt>
                  <dd class="text-teal-900/90 font-body leading-relaxed">
                    <p class="mb-2">{t.definition}</p>
                    {t.seeAlso && (
                      <p class="text-sm text-teal-900/70">
                        See:{' '}
                        <a href={t.seeAlso.url} class="text-amber-600 hover:text-amber-700 underline underline-offset-2">
                          {t.seeAlso.label}
                        </a>
                      </p>
                    )}
                  </dd>
                </div>
              ))}
          </dl>
        </section>
      ))}
    </div>

    <!-- Footer note as surface-muted on teal -->
    <div class="mt-12 surface-muted p-6">
      <p class="font-body text-cream-soft mb-3">
        Got a term that should be in here? Let me know at <a href="mailto:hello@nomadtaxhelp.com" class="text-amber-600 hover:text-amber-700 underline underline-offset-2">hello@nomadtaxhelp.com</a>.
      </p>
      <p class="text-sm text-cream-soft/70 font-body">
        NomadTaxHelp is a facilitator, not a law firm or tax adviser. We coordinate with licensed partners who are. These definitions are educational; specific applications need a professional.
      </p>
    </div>
  </article>
</BaseLayout>
