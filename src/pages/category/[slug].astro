---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CategoryPill from '../../components/ui/CategoryPill.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const meta: Record<string, { label: string; description: string }> = {
    paraguay: {
      label: 'Paraguay',
      description: 'Guides on Paraguay tax residency: setup process, documents, costs, timelines, and ongoing requirements.',
    },
    'tax-residency': {
      label: 'Tax Residency',
      description: 'How to establish, exit, and manage tax residency as a digital nomad or remote entrepreneur.',
    },
    'us-llc': {
      label: 'US LLC',
      description: 'Setting up and running a US LLC as a non-resident: formation, banking, compliance, and tax treatment.',
    },
  };

  return Object.entries(meta).map(([slug, data]) => ({
    params: { slug },
    props: { label: data.label, description: data.description },
  }));
};

const { slug } = Astro.params;
const { label, description } = Astro.props;

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.category === slug);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const categories = [
  { slug: 'paraguay', label: 'Paraguay' },
  { slug: 'tax-residency', label: 'Tax Residency' },
  { slug: 'us-llc', label: 'US LLC' },
];
---

<BaseLayout
  title={`${label} | NomadTaxHelp Blog`}
  description={description}
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl mb-3">{label}</h1>
    <p class="text-gray-600 mb-8 max-w-2xl">{description}</p>

    <!-- Category pills -->
    <div class="flex flex-wrap gap-2 mb-8">
      {categories.map((cat) => (
        <CategoryPill category={cat.slug} label={cat.label} />
      ))}
    </div>

    {sortedPosts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <a
            href={`/posts/${post.data.slug}`}
            class="block bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow no-underline group p-5"
          >
            <h2 class="font-heading font-semibold text-teal-900 text-lg mb-2 group-hover:text-amber-600 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-gray-600 line-clamp-2 mb-3">{post.data.description}</p>
            <time class="text-xs text-gray-600" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-gray-600">No posts in this category yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>
