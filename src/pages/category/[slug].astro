---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CategoryPill from '../../components/ui/CategoryPill.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const meta: Record<string, { label: string; description: string }> = {
    paraguay: {
      label: 'Paraguay',
      description: 'Guides on Paraguay tax residency: setup process, documents, costs, timelines, and ongoing requirements.',
    },
    'tax-residency': {
      label: 'Tax Residency',
      description: 'How to establish, exit, and manage tax residency as a digital nomad or remote entrepreneur.',
    },
    'us-llc': {
      label: 'US LLC',
      description: 'Setting up and running a US LLC as a non-resident: formation, banking, compliance, and tax treatment.',
    },
  };

  return Object.entries(meta).map(([slug, data]) => ({
    params: { slug },
    props: { label: data.label, description: data.description },
  }));
};

const { slug } = Astro.params;
const { label, description } = Astro.props;

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.category === slug);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const categories = [
  { slug: 'paraguay', label: 'Paraguay' },
  { slug: 'tax-residency', label: 'Tax Residency' },
  { slug: 'us-llc', label: 'US LLC' },
];
---

<BaseLayout
  title={`${label} | NomadTaxHelp Blog`}
  description={description}
>
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 py-12 sm:py-16">
    <p class="font-heading text-amber-600 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] mb-4">Category</p>
    <h1 class="font-heading font-bold text-cream-100 mb-3 text-4xl sm:text-5xl tracking-[-0.01em]">{label}</h1>
    <p class="text-cream-soft/85 mb-10 max-w-2xl text-base sm:text-lg leading-relaxed">{description}</p>

    <!-- Category pills -->
    <div class="flex flex-wrap gap-2 mb-10">
      {categories.map((cat) => (
        <CategoryPill category={cat.slug} label={cat.label} />
      ))}
    </div>

    {sortedPosts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <a
            href={`/posts/${post.data.slug}`}
            class="block bg-cream-100 text-teal-900 no-underline group p-5 sm:p-6 transition-all duration-200 hover:-translate-y-0.5"
            style="border-radius: 0.625rem; border: 1px solid rgba(205, 126, 17, 0.2); box-shadow: 0 8px 20px -10px rgba(0,0,0,0.3);"
          >
            <h2 class="font-heading font-bold text-teal-900 text-lg mb-2 group-hover:text-amber-700 transition-colors leading-snug">
              {post.data.title}
            </h2>
            <p class="text-sm text-teal-900/75 line-clamp-2 mb-4 font-body leading-relaxed">{post.data.description}</p>
            <time class="text-xs text-teal-900/55 font-heading uppercase tracking-wider" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-cream-soft/70">No posts in this category yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>
