---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CategoryPill from '../../components/ui/CategoryPill.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const meta: Record<string, { label: string; description: string; question: string; answer: string; reading: [string, string][] }> = {
    paraguay: {
      label: 'Paraguay residency applications',
      question: 'Where should I start if I want to apply from abroad?',
      answer: 'Start with your nationality and your countries of residence during the past three years. These can affect which police records you need. Once you know where each document comes from, ask how it must be certified or translated and whether you must bring the original. That gives you a realistic starting date for the appointment trip.',
      reading: [
        ['Check the document list before ordering records', '/blog/posts/paraguay-residency-requirements'],
        ['Plan the appointment trip and the wait afterwards', '/blog/posts/paraguay-residency-days-and-timeline'],
        ['Check the ordinary route with Migraciones', 'https://migraciones.gov.py/residencia-temporal/'],
      ],
      description: 'Guides on Paraguay tax residency: setup process, documents, costs, timelines, and ongoing requirements.',
    },
    'tax-residency': {
      label: 'Tax residency when moving abroad',
      question: 'Which country’s rules should I check first?',
      answer: 'Write down where you lived and worked during the year of the move, then list the income you received before and after you left. If you keep a home in one country and work in another, the country you leave, the country you enter and the countries where you work can each raise a different question. Start with the guide that matches the decision you face.',
      reading: [
        ['Work out what to ask a departure-year accountant', '/blog/posts/digital-nomad-taxes'],
        ['Check how keeping a home affects a move from Europe', '/blog/posts/european-nomad-tax-playbook'],
        ['Compare potential bases against one travel calendar', '/blog/posts/best-tax-residency-digital-nomads'],
      ],
      description: 'How to establish, exit, and manage tax residency as a digital nomad or remote entrepreneur.',
    },
    'us-llc': {
      label: 'US LLCs for non-US founders',
      question: 'What should I check before forming a US LLC?',
      answer: 'Start with an actual customer payment. Who signs the contract, where do you do the work, which account receives the money, and how will you pay yourself? Those details tell an adviser what to examine before recommending a company. If you already have an LLC, bring its formation documents and a record of money you put in or took out, even if the business made no sales.',
      reading: [
        ['Check a foreign-owned LLC’s first-year filing example', '/blog/posts/paraguay-residency-us-llc'],
        ['Follow a client payment into a business account', '/blog/posts/paraguay-residency-banking'],
        ['Read the IRS instructions on reportable owner transactions', 'https://www.irs.gov/instructions/i5472'],
      ],
      description: 'Setting up and running a US LLC as a non-resident: formation, banking, compliance, and tax treatment.',
    },
  };

  return Object.entries(meta).map(([slug, data]) => ({
    params: { slug },
    props: data,
  }));
};

const { slug } = Astro.params;
const { label, description, question, answer, reading } = Astro.props;

const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.category === slug);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const categories = [
  { slug: 'paraguay', label: 'Paraguay' },
  { slug: 'tax-residency', label: 'Tax Residency' },
  { slug: 'us-llc', label: 'US LLC' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `https://nomadtaxhelp.com/blog/category/${slug}#list`,
  itemListElement: sortedPosts.map((post, index) => ({
    '@type': 'ListItem', position: index + 1, name: post.data.title,
    url: `https://nomadtaxhelp.com/blog/posts/${post.data.slug}`,
  })),
};
---

<BaseLayout
  jsonLd={jsonLd}
  title={`${label} | Nomad Tax Help Blog`}
  description={description}
>
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 py-12 sm:py-16">
    <p class="font-heading text-amber-600 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] mb-4">Category</p>
    <h1 class="font-heading font-bold text-cream-100 mb-3 text-4xl sm:text-5xl tracking-[-0.01em]">{label}</h1>
    <p class="text-cream-soft/85 mb-10 max-w-2xl text-base sm:text-lg leading-relaxed">{description}</p>

    <section class="mb-10 max-w-2xl" aria-labelledby="category-question">
      <h2 id="category-question" class="font-heading font-bold text-cream-100 text-2xl mb-3">{question}</h2>
      <p class="text-cream-soft/85 leading-relaxed">{answer}</p>
      <ul class="mt-4 list-disc pl-5 space-y-2">
        {reading.map(([text, href]) => <li><a class="underline underline-offset-4" href={href}>{text}</a></li>)}
      </ul>
    </section>

    <!-- Category pills -->
    <div class="flex flex-wrap gap-2 mb-10">
      {categories.map((cat) => (
        <CategoryPill category={cat.slug} label={cat.label} />
      ))}
    </div>

    {sortedPosts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <a
            href={`/blog/posts/${post.data.slug}`}
            class="block bg-cream-100 text-teal-900 no-underline group p-5 sm:p-6 transition-all duration-200 hover:-translate-y-0.5"
            style="border-radius: 0.625rem; border: 1px solid rgba(205, 126, 17, 0.2); box-shadow: 0 8px 20px -10px rgba(0,0,0,0.3);"
          >
            <h2 class="font-heading font-bold text-teal-900 text-lg mb-2 group-hover:text-amber-700 transition-colors leading-snug">
              {post.data.title}
            </h2>
            <p class="text-sm text-teal-900/75 line-clamp-2 mb-4 font-body leading-relaxed">{post.data.description}</p>
            <time class="text-xs text-teal-900/55 font-heading uppercase tracking-wider" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-cream-soft/70">No posts in this category yet. Check back soon.</p>
    )}
  </div>
</BaseLayout>
