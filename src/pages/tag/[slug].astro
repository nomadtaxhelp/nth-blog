---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CategoryPill from '../../components/ui/CategoryPill.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

const categoryLabels: Record<string, string> = {
  'paraguay': 'Paraguay',
  'tax-residency': 'Tax Residency',
  'us-llc': 'US LLC',
};

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { slug: tag },
  }));
};

const { slug } = Astro.params;
const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.tags.includes(slug!));
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title={`Posts tagged "${slug}" | NomadTaxHelp Blog`}
  description={`All NomadTaxHelp blog posts tagged with "${slug}".`}
>
  <div class="max-w-[1120px] mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-3xl sm:text-4xl mb-3">
      Posts tagged <span class="text-amber-600">"{slug}"</span>
    </h1>
    <p class="text-gray-600 mb-8">
      {sortedPosts.length} post{sortedPosts.length !== 1 ? 's' : ''} with this tag.
    </p>

    {sortedPosts.length > 0 ? (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <a
            href={`/posts/${post.data.slug}`}
            class="block bg-white rounded-xl border border-gray-200 shadow-sm hover:shadow-md transition-shadow no-underline group p-5"
          >
            <CategoryPill
              category={post.data.category}
              label={categoryLabels[post.data.category] || post.data.category}
              size="sm"
            />
            <h2 class="font-heading font-semibold text-teal-900 text-lg mt-2 mb-2 group-hover:text-amber-600 transition-colors">
              {post.data.title}
            </h2>
            <p class="text-sm text-gray-600 line-clamp-2 mb-3">{post.data.description}</p>
            <time class="text-xs text-gray-600" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-gray-600">No posts with this tag yet.</p>
    )}
  </div>
</BaseLayout>
