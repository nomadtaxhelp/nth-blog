---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import CategoryPill from '../../components/ui/CategoryPill.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

const categoryLabels: Record<string, string> = {
  'paraguay': 'Paraguay',
  'tax-residency': 'Tax Residency',
  'us-llc': 'US LLC',
};

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { slug: tag },
  }));
};

const { slug } = Astro.params;
const allPosts = await getCollection('posts', ({ data }) => !data.draft && data.tags.includes(slug!));
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
---

<BaseLayout
  title={`Posts tagged "${slug}" | NomadTaxHelp Blog`}
  description={`All NomadTaxHelp blog posts tagged with "${slug}".`}
>
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 py-12 sm:py-16">
    <p class="font-heading text-amber-600 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] mb-4">Tag</p>
    <h1 class="font-heading font-bold text-cream-100 mb-3 text-4xl sm:text-5xl tracking-[-0.01em]">
      <span class="text-cream-100">Posts tagged</span> <span class="text-amber-600">"{slug}"</span>
    </h1>
    <p class="text-cream-soft/75 mb-10">
      {sortedPosts.length} post{sortedPosts.length !== 1 ? 's' : ''} with this tag.
    </p>

    {sortedPosts.length > 0 ? (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {sortedPosts.map((post) => (
          <a
            href={`/posts/${post.data.slug}`}
            class="block bg-cream-100 text-teal-900 no-underline group p-5 sm:p-6 transition-all duration-200 hover:-translate-y-0.5"
            style="border-radius: 0.625rem; border: 1px solid rgba(205, 126, 17, 0.2); box-shadow: 0 8px 20px -10px rgba(0,0,0,0.3);"
          >
            <CategoryPill
              category={post.data.category}
              label={categoryLabels[post.data.category] || post.data.category}
              size="sm"
            />
            <h2 class="font-heading font-bold text-teal-900 text-lg mt-3 mb-2 group-hover:text-amber-700 transition-colors leading-snug">
              {post.data.title}
            </h2>
            <p class="text-sm text-teal-900/75 line-clamp-2 mb-4 font-body leading-relaxed">{post.data.description}</p>
            <time class="text-xs text-teal-900/55 font-heading uppercase tracking-wider" datetime={post.data.publishDate.toISOString()}>
              {post.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-cream-soft/70">No posts with this tag yet.</p>
    )}
  </div>
</BaseLayout>
