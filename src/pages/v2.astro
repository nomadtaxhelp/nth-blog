---
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const now = new Date();
const fourteenDaysAgo = new Date(now.getTime() - 14 * 24 * 60 * 60 * 1000);

const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
const healthCheckLink = 'https://nomadtaxhelp.com/health-check';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>NomadTaxHelp — Guides</title>
    <meta name="description" content="Practical tax residency guides for digital nomads. Written by Felix, co-founder of NomadTaxHelp." />
    <link rel="canonical" href="https://blog.nomadtaxhelp.com/v2" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="NomadTaxHelp — Guides" />
    <meta property="og:description" content="Practical tax residency guides for digital nomads. Written by Felix, co-founder of NomadTaxHelp." />
    <meta property="og:url" content="https://blog.nomadtaxhelp.com/v2" />
    <meta property="og:site_name" content="NomadTaxHelp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="NomadTaxHelp Blog" href="/rss.xml" />
  </head>
  <body>
    <div class="v2-content">
      <!-- 1. Site title -->
      <header class="v2-header">
        <a href="https://nomadtaxhelp.com" class="v2-logo" aria-label="NomadTaxHelp home">
          <img src="/logo.svg" alt="NomadTaxHelp" class="v2-logo-img" />
        </a>
      </header>

      <!-- 2. Introduction -->
      <div class="v2-intro">
        <p class="v2-intro-greeting">Hey, I'm Felix <span aria-hidden="true">👋</span></p>
        <p>I get it. Taxes as a digital nomad are a damn nightmare.</p>
        <p>So I built <a href="https://nomadtaxhelp.com" target="_blank" rel="noopener noreferrer" class="v2-intro-link">nomadtaxhelp.com</a> &mdash; where we help people like you become tax-efficient.</p>
        <p>But today, I want to help YOU <span aria-hidden="true">🫵</span></p>
        <p>So here is all the best info and wisdom I have acquired over the last decade in one place.</p>
        <p>Here you can dig through the guides I wish I had&hellip;</p>
      </div>

      <!-- 3. Section heading -->
      <h2 class="v2-section-title">Guides</h2>

      <!-- 4. Post list -->
      <div class="v2-post-list">
        {sortedPosts.map((post) => {
          const isNew = post.data.publishDate >= fourteenDaysAgo;
          return (
            <div class="v2-post-item">
              <a href={`/posts/${post.data.slug}`}>{post.data.title}</a>{isNew && <span class="v2-new-badge"> (new)</span>}
            </div>
          );
        })}
      </div>

      <!-- 5. CTA -->
      <div class="v2-cta">
        <hr class="v2-rule" />
        <p class="v2-cta-heading">Want help sorting yours?</p>
        <div class="v2-cta-buttons">
          <a href={calLink} target="_blank" rel="noopener noreferrer" class="v2-btn v2-btn-primary">
            <span class="v2-btn-emoji" aria-hidden="true">📞</span>
            Book A Clarity Call HERE
          </a>
        </div>
      </div>

      <!-- 6. Footer -->
      <footer class="v2-footer">
        <p>NomadTaxHelp &middot; <a href="mailto:hello@nomadtaxhelp.com">hello@nomadtaxhelp.com</a></p>
        <p class="v2-footer-disclaimer">We're not tax or legal advisers. We work alongside licensed partners who are.</p>
        <p class="v2-footer-links">
          <a href="https://instagram.com/nomadtaxhelp_" target="_blank" rel="noopener noreferrer">Instagram</a>
          &middot;
          <a href="https://nomadtaxhelp.com" target="_blank" rel="noopener noreferrer">Main site</a>
        </p>
      </footer>
    </div>

    <style>
      /* ===== V2 — self-contained, no Tailwind ===== */

      body {
        background: #ffe4c4;
        margin: 0;
        padding: 0;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      * {
        box-sizing: border-box;
      }

      /* Content container — centred. Wide enough for the intro
         to keep each sentence on one line; inner sections are
         constrained back to a narrower column below. */
      .v2-content {
        max-width: 960px;
        margin: 0 auto;
        padding: 0 24px;
      }

      @media (min-width: 1200px) {
        .v2-content {
          padding: 0 40px;
        }
      }

      /* Constrain non-intro sections to the original narrow column */
      .v2-header,
      .v2-section-title,
      .v2-post-list,
      .v2-cta,
      .v2-footer {
        max-width: 620px;
        margin-left: auto;
        margin-right: auto;
      }

      /* --- 1. Site title --- */
      .v2-header {
        padding-top: 48px;
        text-align: center;
      }

      .v2-logo {
        display: inline-block;
        line-height: 0;
        text-decoration: none;
        cursor: pointer;
        transition: opacity 200ms ease;
      }

      .v2-logo:hover {
        opacity: 0.75;
      }

      .v2-logo-img {
        display: block;
        height: 64px;
        width: auto;
        max-width: 240px;
      }

      @media (max-width: 768px) {
        .v2-logo-img {
          height: 52px;
        }
      }

      /* --- 2. Introduction --- */
      .v2-intro {
        margin-top: 80px;
        text-align: center;
      }

      @media (max-width: 768px) {
        .v2-intro {
          margin-top: 56px;
        }
      }

      .v2-intro p {
        font-family: 'Source Serif 4', 'Source Serif Pro', Georgia, 'Times New Roman', serif;
        font-weight: 400;
        font-size: 1.125rem;
        color: #004748;
        line-height: 1.75;
        margin: 0;
      }

      .v2-intro p + p {
        margin-top: 24px;
      }

      .v2-intro-greeting {
        font-size: 1.375rem !important;
        font-weight: 600 !important;
        line-height: 1.4 !important;
      }

      .v2-intro-link {
        color: #cd7e11;
        text-decoration: none;
        border-bottom: 1px solid rgba(205, 126, 17, 0.35);
        transition: border-color 200ms ease;
      }

      .v2-intro-link:hover {
        border-bottom-color: #cd7e11;
      }

      @media (max-width: 768px) {
        .v2-intro p {
          line-height: 1.7;
        }

        .v2-intro-greeting {
          font-size: 1.25rem !important;
        }
      }

      /* --- 3. Section heading --- */
      .v2-section-title {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        color: #004748;
        text-align: center;
        margin-top: 72px;
        margin-bottom: 32px;
        text-decoration: none;
      }

      /* --- 4. Post list --- */
      .v2-post-list {
        text-align: center;
      }

      .v2-post-item {
        margin-bottom: 20px;
        line-height: 1.4;
      }

      .v2-post-item a {
        font-family: 'Source Serif 4', 'Source Serif Pro', Georgia, 'Times New Roman', serif;
        font-weight: 400;
        font-size: 1.0625rem;
        color: #004748;
        text-decoration: none;
        cursor: pointer;
        transition: color 200ms ease;
      }

      .v2-post-item a:hover {
        color: #cd7e11;
        text-decoration: underline;
      }

      .v2-new-badge {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 400;
        font-style: italic;
        font-size: 0.8125rem;
        color: #cd7e11;
      }

      /* --- 5. CTA --- */
      .v2-cta {
        margin-top: 80px;
        text-align: center;
      }

      .v2-rule {
        width: 80px;
        border: none;
        border-top: 1px solid rgba(0, 71, 72, 0.2);
        margin: 0 auto 40px auto;
      }

      .v2-cta-heading {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 600;
        font-size: 1.125rem;
        color: #004748;
        margin: 0 0 24px 0;
      }

      .v2-cta-buttons {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .v2-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 600;
        font-size: 1rem;
        text-decoration: none;
        cursor: pointer;
        padding: 14px 24px;
        border-radius: 10px;
        min-width: 240px;
        transition: transform 150ms ease, box-shadow 200ms ease, background-color 200ms ease, color 200ms ease, border-color 200ms ease;
      }

      .v2-btn-emoji {
        font-size: 1.125rem;
        line-height: 1;
      }

      .v2-btn-primary {
        background-color: #cd7e11;
        color: #ffffff;
        border: 2px solid #cd7e11;
        box-shadow: 0 1px 2px rgba(0, 71, 72, 0.08);
      }

      .v2-btn-primary:hover {
        background-color: #b56c0a;
        border-color: #b56c0a;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(205, 126, 17, 0.25);
      }

      .v2-btn-secondary {
        background-color: #004748;
        color: #ffe4c4;
        border: 2px solid #004748;
        box-shadow: 0 1px 2px rgba(0, 71, 72, 0.08);
      }

      .v2-btn-secondary:hover {
        background-color: #003738;
        border-color: #003738;
        color: #ffe4c4;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(0, 71, 72, 0.25);
      }

      @media (max-width: 600px) {
        .v2-cta-buttons {
          flex-direction: column;
        }

        .v2-btn {
          min-width: 0;
          width: 100%;
          font-size: 0.9375rem;
          padding: 13px 20px;
        }
      }

      /* --- 6. Footer --- */
      .v2-footer {
        margin-top: 80px;
        padding-bottom: 48px;
        text-align: center;
      }

      .v2-footer p {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 400;
        font-size: 0.75rem;
        color: rgba(0, 71, 72, 0.35);
        margin: 0;
        line-height: 1.5;
      }

      .v2-footer a {
        color: rgba(0, 71, 72, 0.35);
        text-decoration: none;
        cursor: pointer;
        transition: color 200ms ease;
      }

      .v2-footer a:hover {
        text-decoration: underline;
      }

      .v2-footer-disclaimer {
        margin-top: 8px;
      }

      .v2-footer-links {
        margin-top: 4px;
      }
    </style>
  </body>
</html>
