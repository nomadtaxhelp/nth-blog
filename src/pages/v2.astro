---
import BaseLayout from '../components/layout/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { allFaqItems } from '../data/faq';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const featuredPost = sortedPosts.find((p) => p.data.featured) || sortedPosts[0];
const recentPosts = sortedPosts.filter((p) => p !== featuredPost).slice(0, 6);

const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';

// Latest content date — used for dateModified freshness signal.
const latestDate = sortedPosts[0]?.data.publishDate || new Date();

// Alternate homepage layout — kept at /v2 after the route swap. The
// minimalist greeting layout now lives at /. Schema points back at the
// canonical site (/) so search and AI engines treat this as the same blog.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Blog',
      '@id': 'https://blog.nomadtaxhelp.com/#blog',
      url: 'https://blog.nomadtaxhelp.com',
      name: 'NomadTaxHelp Blog',
      description: 'Practical guides on tax residency, Paraguay setup, US LLCs, and tax exit strategy for European and rest-of-world digital nomads.',
      author: { '@id': 'https://blog.nomadtaxhelp.com/about#felix' },
      publisher: { '@id': 'https://nomadtaxhelp.com/#organization' },
      inLanguage: 'en',
      dateModified: latestDate.toISOString(),
      blogPost: sortedPosts.slice(0, 6).map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        url: `https://blog.nomadtaxhelp.com/posts/${p.data.slug}`,
        datePublished: p.data.publishDate.toISOString(),
        description: p.data.description,
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': 'https://blog.nomadtaxhelp.com/v2#faq',
      url: 'https://blog.nomadtaxhelp.com/faq',
      mainEntity: allFaqItems.slice(0, 8).map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: item.a },
      })),
    },
  ],
};
---

<BaseLayout
  title="NomadTaxHelp Blog | Featured guides and recent posts"
  description="Featured tax-residency guide and the latest 6 posts from the NomadTaxHelp blog. Alternate magazine-style homepage layout."
  canonicalUrl="https://blog.nomadtaxhelp.com/v2"
  jsonLd={jsonLd}
>
  {/* Hero: cream slab on teal page bg */}
  <section class="surface-cream max-w-[1200px] mx-auto mt-8 mb-16 py-16 sm:py-20 px-6 text-center">
    <div class="max-w-[720px] mx-auto">
      <p class="font-heading text-amber-600 text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] mb-5">
        NomadTaxHelp Blog
      </p>
      <h1 class="font-heading font-bold text-teal-900 mb-5" style="font-size: clamp(2rem, 5vw, 3.5rem); line-height: 1.1; letter-spacing: -0.01em;">
        Practical guides for nomads sorting their tax setup.
      </h1>
      <p class="font-body text-teal-900/75 mb-7 max-w-[520px] mx-auto text-base sm:text-lg leading-relaxed">
        Written by Felix, co-founder of NomadTaxHelp. No jargon, no hype, no tax-adviser disclaimers written by lawyers. Just what actually works.
      </p>
      <ul class="text-left max-w-[520px] mx-auto mb-9 space-y-2 font-body text-teal-900/85 text-sm sm:text-base">
        <li class="flex items-start gap-2.5">
          <span class="text-amber-600 font-bold shrink-0" aria-hidden="true">→</span>
          <span>European tax-exit playbooks (UK SRT, Spain, Wegzugsteuer, France, Italy)</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-amber-600 font-bold shrink-0" aria-hidden="true">→</span>
          <span>Paraguay tax-residency setup, costs, timelines, and defensibility</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-amber-600 font-bold shrink-0" aria-hidden="true">→</span>
          <span>Crypto realisation timing and the order-of-operations that matters</span>
        </li>
        <li class="flex items-start gap-2.5">
          <span class="text-amber-600 font-bold shrink-0" aria-hidden="true">→</span>
          <span>Compliance: OECD CRS, EU lists, banking acceptance, audit risk</span>
        </li>
      </ul>
      <div class="flex justify-center">
        <a
          href={calLink}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-shimmer inline-flex items-center px-8 py-3.5 font-heading font-semibold no-underline text-base"
          style="border-radius: 0.625rem;"
        >
          Book a Call
        </a>
      </div>
    </div>
  </section>

  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 pb-16">
    {/* Featured post */}
    {featuredPost && (
      <section class="mb-14">
        <p class="font-heading text-amber-600 text-xs font-semibold uppercase tracking-[0.18em] mb-4">Featured</p>
        <a
          href={`/posts/${featuredPost.data.slug}`}
          class="block bg-cream-100 text-teal-900 no-underline overflow-hidden group transition-all duration-200 hover:-translate-y-0.5"
          style="border-radius: 0.625rem; box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4);"
        >
          <div class="p-7 sm:p-9">
            <h2 class="font-heading font-bold text-teal-900 mb-3 group-hover:text-amber-700 transition-colors" style="font-size: 1.75rem; line-height: 1.2; letter-spacing: -0.01em;">
              {featuredPost.data.title}
            </h2>
            <p class="font-body text-teal-900/80 mb-5 max-w-2xl text-base leading-relaxed">
              {featuredPost.data.description}
            </p>
            <div class="flex items-center gap-3 font-heading text-xs text-teal-900/60 uppercase tracking-wider">
              <span>Felix Yanez-Bowker</span>
              <span>&middot;</span>
              <time datetime={featuredPost.data.publishDate.toISOString()}>
                {featuredPost.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
              {featuredPost.data.readingTime && (
                <>
                  <span>&middot;</span>
                  <span>{featuredPost.data.readingTime} min read</span>
                </>
              )}
            </div>
          </div>
        </a>
      </section>
    )}

    {/* Recent posts grid */}
    {recentPosts.length > 0 && (
      <section class="mb-16">
        <h2 class="font-heading font-bold text-cream-100 text-2xl mb-6 tracking-[-0.01em]">Recent guides</h2>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {recentPosts.map((post) => (
            <a
              href={`/posts/${post.data.slug}`}
              class="block bg-cream-100 text-teal-900 no-underline group p-5 sm:p-6 transition-all duration-200 hover:-translate-y-0.5"
              style="border-radius: 0.625rem; border: 1px solid rgba(205, 126, 17, 0.2); box-shadow: 0 8px 20px -10px rgba(0,0,0,0.3);"
            >
              <h3 class="font-heading font-bold text-teal-900 text-lg mb-2 group-hover:text-amber-700 transition-colors leading-snug">
                {post.data.title}
              </h3>
              <p class="text-sm text-teal-900/75 line-clamp-2 mb-4 font-body leading-relaxed">{post.data.description}</p>
              <time class="text-xs text-teal-900/55 font-heading uppercase tracking-wider" datetime={post.data.publishDate.toISOString()}>
                {post.data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
              </time>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* Bottom CTA */}
    <section class="surface-cream px-6 sm:px-8 py-14 sm:py-16 text-center" style="box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4);">
      <p class="font-heading text-amber-600 text-xs font-semibold uppercase tracking-[0.18em] mb-3">
        Want help sorting yours?
      </p>
      <h2 class="font-heading font-bold text-teal-900 mb-3 text-2xl sm:text-3xl tracking-[-0.01em]">
        Ready to sort your tax setup?
      </h2>
      <p class="font-body text-teal-900/75 mb-7 mx-auto max-w-[480px] text-base">
        Book a free 20-minute clarity call. I'll map your situation, flag the risks, and give you a one-page plan to act on.
      </p>
      <a
        href={calLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shimmer inline-flex items-center font-heading font-semibold no-underline text-base"
        style="padding: 14px 32px; border-radius: 0.625rem;"
      >
        Schedule a Clarity Call &rarr;
      </a>
    </section>
  </div>
</BaseLayout>
