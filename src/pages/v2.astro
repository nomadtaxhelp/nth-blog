---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const now = new Date();
const fourteenDaysAgo = new Date(now.getTime() - 14 * 24 * 60 * 60 * 1000);

const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
const healthCheckLink = 'https://nomadtaxhelp.com/health-check';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>NomadTaxHelp — Guides</title>
    <meta name="description" content="Practical tax residency guides for digital nomads. Written by Felix, co-founder of NomadTaxHelp." />
    <link rel="canonical" href="https://blog.nomadtaxhelp.com/v2" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content="NomadTaxHelp — Guides" />
    <meta property="og:description" content="Practical tax residency guides for digital nomads. Written by Felix, co-founder of NomadTaxHelp." />
    <meta property="og:url" content="https://blog.nomadtaxhelp.com/v2" />
    <meta property="og:site_name" content="NomadTaxHelp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,400;0,14..32,500;0,14..32,600;0,14..32,700;1,14..32,400&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
      rel="stylesheet"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="NomadTaxHelp Blog" href="/rss.xml" />
  </head>
  <body style="background: #ffe4c4; margin: 0; padding: 0; min-height: 100vh;">
    <div class="v2-page">
      <!-- Header -->
      <header class="v2-header">
        <a href="https://nomadtaxhelp.com" class="v2-logo">NomadTaxHelp</a>
      </header>

      <!-- Introduction -->
      <div class="v2-intro">
        <p>Hi, I'm Felix.<br />
        I help nomads sort their tax setup.<br />
        These are the guides I wish I'd had.</p>
      </div>

      <!-- Section title -->
      <h2 class="v2-section-title">Guides</h2>

      <!-- Post list -->
      <ul class="v2-post-list">
        {sortedPosts.map((post) => {
          const isNew = post.data.publishDate >= fourteenDaysAgo;
          return (
            <li>
              <a href={`/posts/${post.data.slug}`}>{post.data.title}</a>
              {isNew && <span class="v2-new-badge">(new)</span>}
            </li>
          );
        })}
      </ul>

      <!-- Spacer -->
      <div style="height: 80px;"></div>

      <!-- CTA -->
      <div class="v2-cta">
        <hr class="v2-rule" />
        <p class="v2-cta-heading">Want help sorting yours?</p>
        <a href={calLink} target="_blank" rel="noopener noreferrer" class="v2-cta-primary">
          Book a free clarity call &rarr;
        </a>
        <a href={healthCheckLink} target="_blank" rel="noopener noreferrer" class="v2-cta-secondary">
          Or take the free Health Check &rarr;
        </a>
      </div>

      <!-- Footer -->
      <footer class="v2-footer">
        <p>NomadTaxHelp — hello@nomadtaxhelp.com</p>
        <p>We're not tax or legal advisers. We work alongside licensed partners who are.</p>
      </footer>
    </div>

    <style>
      /* V2 page — self-contained styles, no Tailwind dependency for layout */
      .v2-page {
        max-width: 600px;
        padding: 0 40px 40px 40px;
        /* Left-biased: on wide screens, offset ~20% from left */
        margin-left: max(40px, calc(20vw - 80px));
        margin-right: auto;
      }

      @media (max-width: 768px) {
        .v2-page {
          padding: 0 24px 40px 24px;
          margin-left: 0;
        }
      }

      /* Header */
      .v2-header {
        padding-top: 40px;
      }

      @media (max-width: 768px) {
        .v2-header {
          padding-top: 24px;
        }
      }

      .v2-logo {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 600;
        font-size: 1.125rem;
        color: #004748;
        text-decoration: none;
        cursor: pointer;
      }

      .v2-logo:hover {
        color: #004748;
      }

      /* Intro */
      .v2-intro {
        margin-top: 120px;
      }

      @media (max-width: 768px) {
        .v2-intro {
          margin-top: 80px;
        }
      }

      .v2-intro p {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 400;
        font-size: 1.125rem;
        color: #004748;
        line-height: 1.8;
        margin: 0;
      }

      /* Section title */
      .v2-section-title {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 700;
        font-size: 1.5rem;
        color: #004748;
        margin-top: 64px;
        margin-bottom: 24px;
        text-decoration: none;
      }

      /* Post list */
      .v2-post-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }

      .v2-post-list li {
        margin-bottom: 16px;
        line-height: 1.4;
      }

      .v2-post-list a {
        font-family: 'Source Serif 4', 'Source Serif Pro', Georgia, serif;
        font-weight: 400;
        font-size: 1.0625rem;
        color: #004748;
        text-decoration: none;
        cursor: pointer;
        transition: text-decoration 150ms ease;
      }

      .v2-post-list a:hover {
        text-decoration: underline;
        color: #004748;
      }

      .v2-new-badge {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 400;
        font-size: 0.8125rem;
        color: #cd7e11;
        margin-left: 6px;
      }

      /* CTA */
      .v2-cta {
        max-width: 600px;
      }

      .v2-rule {
        border: none;
        border-top: 1px solid rgba(0, 71, 72, 0.2);
        margin: 0 0 40px 0;
        max-width: 600px;
      }

      .v2-cta-heading {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 600;
        font-size: 1.125rem;
        color: #004748;
        margin: 0 0 12px 0;
      }

      .v2-cta-primary {
        display: block;
        font-family: 'Source Serif 4', 'Source Serif Pro', Georgia, serif;
        font-weight: 400;
        font-size: 1rem;
        color: #cd7e11;
        text-decoration: none;
        cursor: pointer;
        margin-bottom: 8px;
      }

      .v2-cta-primary:hover {
        text-decoration: underline;
        color: #cd7e11;
      }

      .v2-cta-secondary {
        display: block;
        font-family: 'Source Serif 4', 'Source Serif Pro', Georgia, serif;
        font-weight: 400;
        font-size: 0.875rem;
        color: rgba(0, 71, 72, 0.6);
        text-decoration: none;
        cursor: pointer;
      }

      .v2-cta-secondary:hover {
        text-decoration: underline;
      }

      /* Footer */
      .v2-footer {
        margin-top: 80px;
        padding-bottom: 0;
      }

      .v2-footer p {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        font-weight: 400;
        font-size: 0.75rem;
        color: rgba(0, 71, 72, 0.4);
        margin: 0 0 4px 0;
        line-height: 1.5;
      }
    </style>
  </body>
</html>
