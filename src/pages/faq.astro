---
import { faqSections as sections, allFaqItems as allItems } from "../data/faq";
import BaseLayout from '../components/layout/BaseLayout.astro';

const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';


// FAQPage schema with every Q&A pair. Strips link-syntax artifacts from
// answer text so the schema text is plain prose for AI engines.
const faqSchema = {
  '@type': 'FAQPage',
  '@id': 'https://blog.nomadtaxhelp.com/faq#faqpage',
  url: 'https://blog.nomadtaxhelp.com/faq',
  name: 'NomadTaxHelp FAQ',
  description:
    'Common questions European and rest-of-world digital nomads ask about tax residency, exiting their home country, Paraguay setup, crypto, and the NomadTaxHelp service.',
  inLanguage: 'en',
  mainEntity: allItems.map((item) => {
    const seeAlsoText = item.seeAlso ? ` See also: ${item.seeAlso.label} (${item.seeAlso.url}).` : '';
    return {
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a + seeAlsoText },
    };
  }),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    faqSchema,
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://blog.nomadtaxhelp.com/' },
        { '@type': 'ListItem', position: 2, name: 'FAQ', item: 'https://blog.nomadtaxhelp.com/faq' },
      ],
    },
  ],
};
---

<BaseLayout
  title="Frequently Asked Questions | NomadTaxHelp Blog"
  description="The questions European and rest-of-world digital nomads actually ask about tax residency, exiting their home country, Paraguay setup, crypto realisation strategy, and the NomadTaxHelp service."
  jsonLd={jsonLd}
>
  <article class="max-w-[860px] mx-auto px-5 sm:px-8 py-12 sm:py-16">
    <h1 class="font-heading font-bold text-cream-100 mb-5 text-4xl sm:text-5xl tracking-[-0.01em]">Everything Nomads Ask About Tax Residency</h1>
    <p class="text-base sm:text-lg text-cream-soft/85 mb-10 max-w-[640px] font-body leading-relaxed">
      If your question isn't covered in the guides, it's probably here. Use the quick-jump below or scroll through.
    </p>

    {/* Section quick-nav */}
    <nav class="flex flex-wrap gap-2 mb-12" aria-label="FAQ sections">
      {sections.map((s) => (
        <a
          href={`#${s.id}`}
          class="inline-block px-3.5 py-1.5 bg-cream-100/10 hover:bg-amber-600 text-cream-100 hover:text-teal-900 no-underline text-sm font-heading font-medium transition-colors"
          style="border-radius: 0.5rem;"
        >
          {s.title}
        </a>
      ))}
    </nav>

    {sections.map((s) => (
      <section id={s.id} class="mb-12 scroll-mt-24">
        <h2 class="font-heading font-bold text-cream-100 text-2xl sm:text-3xl mb-3 tracking-[-0.01em]">{s.title}</h2>
        {s.intro && (
          <p class="text-cream-soft/75 mb-6 max-w-[640px] font-body leading-relaxed">{s.intro}</p>
        )}
        <div class="space-y-3">
          {s.items.map((item) => (
            <details class="group surface-muted overflow-hidden">
              <summary class="cursor-pointer px-5 py-4 font-heading font-semibold text-cream-100 text-base flex items-center justify-between gap-3 list-none [&::-webkit-details-marker]:hidden">
                <span class="flex-1">{item.q}</span>
                <svg
                  class="w-5 h-5 shrink-0 text-amber-600 transition-transform group-open:rotate-180"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-5 pb-5 text-sm sm:text-base text-cream-soft/85 leading-relaxed font-body">
                <p>{item.a}</p>
                {item.seeAlso && (
                  <p class="mt-3 text-sm">
                    <span class="text-cream-soft/60">See also: </span>
                    <a href={item.seeAlso.url} class="text-amber-600 hover:text-amber-700 underline underline-offset-2">{item.seeAlso.label}</a>
                  </p>
                )}
              </div>
            </details>
          ))}
        </div>
      </section>
    ))}

    {/* Bottom CTA */}
    <section class="surface-cream p-8 sm:p-10 text-center mt-16" style="box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4);">
      <p class="font-heading text-amber-600 text-xs font-semibold uppercase tracking-[0.18em] mb-3">Need help with your tax setup?</p>
      <p class="text-teal-900/75 mb-7 max-w-[480px] mx-auto font-body">
        We can have a 1-1 call, explore your situation and point you towards a more tax-efficient setup.
      </p>
      <a
        href={calLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shimmer inline-flex items-center px-7 py-3.5 font-heading font-semibold no-underline"
        style="border-radius: 0.625rem;"
      >
        Let's Chat ☎️
      </a>
    </section>
  </article>
</BaseLayout>
