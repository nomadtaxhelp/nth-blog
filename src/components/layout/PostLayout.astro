---
import BaseLayout from './BaseLayout.astro';
import '../../styles/banking-guide.css';
import BankingVideo from '../post/BankingVideo.astro';
import AnswerCapsule from '../post/AnswerCapsule.astro';
import TableOfContents from '../post/TableOfContents.astro';
import AuthorByline from '../post/AuthorByline.astro';
import RelatedPosts from '../post/RelatedPosts.astro';
import LastUpdated from '../post/LastUpdated.astro';
import FAQAccordion from '../post/FAQAccordion.astro';
import EndOfPostCTA from '../cta/EndOfPostCTA.astro';
import SidebarCTA from '../cta/SidebarCTA.astro';
import ExitIntentModal from '../cta/ExitIntentModal.astro';
import CategoryPill from '../ui/CategoryPill.astro';
import { felix, organization } from '../../data/felix';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: { depth: number; slug: string; text: string }[];
  relatedPosts?: CollectionEntry<'posts'>[];
}

const { post, headings, relatedPosts = [] } = Astro.props;
const { data } = post;
const isBankingGuide = data.slug === "paraguay-residency-after-ueno";

const categoryLabels: Record<string, string> = {
  'paraguay': 'Paraguay',
  'tax-residency': 'Tax Residency',
  'us-llc': 'US LLC',
};

const categoryLabel = categoryLabels[data.category] || data.category;
const canonicalUrl = `https://nomadtaxhelp.com/blog/posts/${data.slug}`;
const markdownUrl = `https://nomadtaxhelp.com/blog/posts/${data.slug}.md`;
// Per-post dynamic OG image generated at build time.
const ogImageUrl = `https://nomadtaxhelp.com/blog/og/${data.slug}.png`;
const readingTime = data.readingTime || Math.ceil((post.body?.length || 0) / 1500);

const personAuthor = {
  '@type': 'Person',
  '@id': 'https://nomadtaxhelp.com/blog/about#felix',
  name: felix.name,
  url: felix.url,
  image: felix.image,
  jobTitle: felix.jobTitle,
  description: felix.description,
  knowsAbout: felix.knowsAbout,
  sameAs: felix.sameAs,
};

const publisherOrg = {
  '@type': 'Organization',
  '@id': 'https://nomadtaxhelp.com/#organization',
  name: organization.name,
  url: organization.url,
  logo: {
    '@type': 'ImageObject',
    url: organization.logo,
  },
  sameAs: organization.sameAs,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${canonicalUrl}#article`,
      headline: data.title,
      description: data.description,
      author: data.author === 'nth' ? publisherOrg : personAuthor,
      publisher: publisherOrg,
      datePublished: data.publishDate.toISOString(),
      dateModified: (data.updatedDate || data.publishDate).toISOString(),
      image: data.heroImage
        ? new URL(data.heroImage, 'https://nomadtaxhelp.com').href
        : ogImageUrl,
      mainEntityOfPage: { '@id': `${canonicalUrl}#webpage` },
      isPartOf: { '@id': 'https://nomadtaxhelp.com/blog/#blog' },
      inLanguage: 'en',
      articleSection: categoryLabel,
      keywords: (data.tags || []).join(', '),
      url: canonicalUrl,
      citation: data.sources.map((source) => source.url),
      ...(data.video ? { video: { '@id': `${canonicalUrl}#video` } } : {}),
    },
    ...(data.video ? [{
      '@type': 'VideoObject',
      '@id': `${canonicalUrl}#video`,
      name: data.video.title,
      description: data.video.description,
      thumbnailUrl: [data.video.poster],
      uploadDate: data.video.uploadDate.toISOString(),
      duration: data.video.duration,
      contentUrl: data.video.contentUrl,
      mainEntityOfPage: canonicalUrl,
      inLanguage: 'en',
      isAccessibleForFree: true,
      publisher: publisherOrg,
    }] : []),
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Blog', item: 'https://nomadtaxhelp.com/blog/' },
        { '@type': 'ListItem', position: 2, name: categoryLabel, item: `https://nomadtaxhelp.com/blog/category/${data.category}` },
        { '@type': 'ListItem', position: 3, name: data.title },
      ],
    },
    ...(data.faqItems && data.faqItems.length > 0
      ? [{
          '@type': 'FAQPage',
          mainEntity: data.faqItems.map((faq: { question: string; answer: string }) => ({
            '@type': 'Question',
            name: faq.question,
            acceptedAnswer: { '@type': 'Answer', text: faq.answer },
          })),
        }]
      : []),
  ],
};
---

<BaseLayout
  title={`${data.title} | NomadTaxHelp`}
  description={data.description}
  canonicalUrl={canonicalUrl}
  ogImage={data.heroImage ? new URL(data.heroImage, 'https://nomadtaxhelp.com').href : ogImageUrl}
  ogType="article"
  jsonLd={jsonLd}
  markdownUrl={markdownUrl}
>
  <article class:list={["max-w-[1200px] mx-auto px-5 sm:px-8 py-10", { "banking-guide": isBankingGuide }]}>
    <!-- Breadcrumb -->
    <nav class="text-sm text-cream-soft/60 mb-5" aria-label="Breadcrumb">
      <ol class="flex items-center gap-1.5 flex-wrap">
        <li><a href="/blog" class="hover:text-amber-600 no-underline text-cream-soft/60">Blog</a></li>
        <li class="text-cream-soft/40">/</li>
        <li><a href={`/blog/category/${data.category}`} class="hover:text-amber-600 no-underline text-cream-soft/60">{categoryLabel}</a></li>
        <li class="text-cream-soft/40">/</li>
        <li class="text-cream-100 truncate max-w-[300px]">{data.title}</li>
      </ol>
    </nav>

    <div class="post-layout lg:grid lg:grid-cols-[1fr_300px] lg:gap-10">
      <!-- Main content column -->
      <div class="post-main max-w-[760px]">
        <!-- Category pill -->
        <div class="mb-4">
          <CategoryPill category={data.category} label={categoryLabel} />
        </div>

        <!-- H1 — cream on teal -->
        <h1 class="text-3xl sm:text-5xl text-cream-100 font-heading font-bold leading-[1.1] tracking-[-0.01em] mb-5">{data.title}</h1>

        <!-- Metadata row -->
        <div class="flex flex-wrap items-center gap-3 text-sm text-cream-soft/70 mb-8">
          <AuthorByline author={data.author} />
          <span class="text-cream-soft/30">&middot;</span>
          <time datetime={data.publishDate.toISOString()}>
            {data.publishDate.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          {data.updatedDate && data.updatedDate > data.publishDate && (
            <>
              <span class="text-cream-soft/30">&middot;</span>
              <LastUpdated date={data.updatedDate} />
            </>
          )}
          <span class="text-cream-soft/30">&middot;</span>
          <span>{readingTime} min read</span>
        </div>

        {data.video && <BankingVideo video={data.video} />}

        <!-- Answer capsule -->
        {data.answerCapsule && (
          <AnswerCapsule text={data.answerCapsule} />
        )}

        <!-- Table of contents -->
        {headings.length > 0 && (
          <TableOfContents headings={headings} />
        )}

        <!-- Post body — cream surface card -->
        <div class="post-reading bg-cream-100 text-teal-900 mt-10 p-6 sm:p-10" style="border-radius: 0.625rem; box-shadow: 0 10px 30px -10px rgba(0,0,0,0.15);">
          <div class="prose">
            <slot />
            {data.sources.length > 0 && (
              <section aria-label="Sources">
                <h2>Sources checked for this guide</h2>
                <p>Checked on {(data.updatedDate || data.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}. Official rules and NTH service information are identified separately below.</p>
                <ul>{data.sources.map((source) => <li><a href={source.url}>{source.name}</a></li>)}</ul>
              </section>
            )}
          </div>
        </div>

        <!-- FAQ section -->
        {data.faqItems && data.faqItems.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl font-heading font-bold text-cream-100 mb-6">Frequently asked questions</h2>
            <FAQAccordion items={data.faqItems} />
          </section>
        )}

        <!-- Related posts -->
        {relatedPosts.length > 0 && (
          <section class="mt-12">
            <h2 class="text-2xl font-heading font-bold text-cream-100 mb-6">Related posts</h2>
            <RelatedPosts posts={relatedPosts} />
          </section>
        )}

        <!-- Author bio box -->
        {data.author === 'felix' ? <div class="mt-12 p-6 surface-muted">
          <div class="flex items-start gap-4">
            <a
              href="/blog/images/felix.png"
              data-lightbox="/blog/images/felix.png"
              data-lightbox-alt="Felix Yanez-Bowker"
              class="shrink-0 no-underline"
              aria-label="View larger photo of Felix"
            >
              <img
                src="/blog/images/felix.png"
                alt="Felix Yanez-Bowker"
                loading="lazy"
                width="64"
                height="64"
                class="w-16 h-16 rounded-full object-cover border border-cream-100/20"
              />
            </a>
            <div>
              <p class="font-heading font-semibold text-cream-100">Felix Yanez-Bowker</p>
              <p class="text-sm text-cream-soft/70 mb-2">Co-Founder, NomadTaxHelp</p>
              <p class="text-sm text-cream-soft/80">
                Felix helps digital nomads and remote entrepreneurs build legal, low-tax setups.
                <a href="/blog/about" class="text-amber-600 hover:text-amber-700">Read more about Felix &rarr;</a>
              </p>
            </div>
          </div>
        </div> : <div class="mt-12 p-6 surface-muted">
          <p class="font-heading font-semibold text-cream-100">Nomad Tax Help</p>
          <p class="text-sm text-cream-soft/80">Practical residency guides using official sources and NTH's published service information. <a href="/services" class="text-amber-600 hover:text-amber-700">Meet the team and see our services</a>.</p>
        </div>}

        <!-- End-of-post CTA -->
        <EndOfPostCTA />
      </div>

      <!-- Desktop sidebar -->
      <aside class="post-service-sidebar hidden lg:block">
        <div class="sticky top-24">
          <SidebarCTA />
        </div>
      </aside>
    </div>
  </article>

  <ExitIntentModal />
</BaseLayout>
