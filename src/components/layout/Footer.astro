---
const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
const currentYear = new Date().getFullYear();
---

<!-- Footer CTA strip -->
<section class="bg-teal-deep text-cream-100 py-14 px-5">
  <div class="max-w-[720px] mx-auto text-center">
    <p class="font-heading text-amber-600 text-xs font-semibold uppercase tracking-[0.18em] mb-3">Need help with your tax setup?</p>
    <p class="text-cream-soft/80 mb-8 font-body text-base max-w-[520px] mx-auto">
      We can have a 1-1 call, explore your situation and point you towards a more tax-efficient setup.
    </p>
    <a
      href={calLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-shimmer inline-flex items-center px-7 py-3.5 font-heading font-semibold no-underline"
      style="border-radius: 0.625rem;"
    >
      Let's Chat ☎️
    </a>
  </div>
</section>

<!-- Footer -->
<footer class="bg-teal-deep border-t border-cream-100/10 text-cream-soft/70 py-10 px-5">
  <div class="max-w-[1200px] mx-auto grid gap-8 md:grid-cols-3">
    <!-- Brand -->
    <div>
      <p class="font-heading font-bold text-cream-100 text-lg mb-2">NomadTaxHelp</p>
      <p class="text-sm leading-relaxed text-cream-soft/70">
        We help digital nomads and remote entrepreneurs build legal, compliant, low-tax setups. Paraguay residency, US LLC formation, and tax exit strategy.
      </p>
    </div>

    <!-- Nav -->
    <div>
      <p class="font-heading font-semibold text-cream-100 text-sm mb-3 uppercase tracking-wider">Links</p>
      <nav class="flex flex-col gap-2">
        <a href="/about" class="text-sm text-cream-soft/70 hover:text-amber-600 no-underline transition-colors duration-200">About</a>
        <a href="/faq" class="text-sm text-cream-soft/70 hover:text-amber-600 no-underline transition-colors duration-200">FAQ</a>
        <a href="/glossary" class="text-sm text-cream-soft/70 hover:text-amber-600 no-underline transition-colors duration-200">Glossary</a>
        <a href="https://nomadtaxhelp.com" target="_blank" rel="noopener noreferrer" class="text-sm text-cream-soft/70 hover:text-amber-600 no-underline transition-colors duration-200">Main Site</a>
        <a href={calLink} target="_blank" rel="noopener noreferrer" class="text-sm text-cream-soft/70 hover:text-amber-600 no-underline transition-colors duration-200">Schedule a Call</a>
        <a href="https://instagram.com/nomadtaxhelp_" target="_blank" rel="noopener noreferrer" class="text-sm text-cream-soft/70 hover:text-amber-600 no-underline transition-colors duration-200">Instagram</a>
      </nav>
    </div>

    <!-- Contact -->
    <div>
      <p class="font-heading font-semibold text-cream-100 text-sm mb-3 uppercase tracking-wider">Contact</p>
      <a href="mailto:hello@nomadtaxhelp.com" class="text-sm text-cream-soft/70 hover:text-amber-600 no-underline transition-colors duration-200">
        hello@nomadtaxhelp.com
      </a>
    </div>
  </div>

  <div class="max-w-[1200px] mx-auto mt-8 pt-6 border-t border-cream-100/10 text-center text-xs text-cream-soft/60">
    <p class="mb-1">NomadTaxHelp is a facilitator, not a law firm or tax adviser. We coordinate with licensed partners who are.</p>
    <p class="text-cream-soft/40">&copy; {currentYear} NomadTaxHelp. All rights reserved.</p>
  </div>
</footer>
