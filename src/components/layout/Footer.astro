---
const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
const currentYear = new Date().getFullYear();
---

<!-- Footer CTA strip -->
<section class="bg-teal-900 text-cream-100 py-12 px-4">
  <div class="max-w-[680px] mx-auto text-center">
    <h2 class="font-heading text-2xl font-bold text-cream-100 mb-3">Ready to sort your tax setup?</h2>
    <p class="text-cream-100/80 mb-6 font-body">
      Book a free 20-min clarity call. I'll map your situation, flag the risks, and give you a one-page plan to act on.
    </p>
    <a
      href={calLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center px-8 py-3.5 rounded-lg bg-amber-600 text-white font-heading font-semibold no-underline hover:bg-amber-700 transition-[background-color] duration-200"
    >
      Book a Call &rarr;
    </a>
  </div>
</section>

<!-- Footer -->
<footer class="bg-teal-900 border-t border-white/10 text-cream-100/70 py-10 px-4">
  <div class="max-w-[1120px] mx-auto grid gap-8 md:grid-cols-3">
    <!-- Brand -->
    <div>
      <p class="font-heading font-bold text-cream-100 text-lg mb-2">NomadTaxHelp</p>
      <p class="text-sm leading-relaxed">
        Helps digital nomads and remote entrepreneurs build legal, compliant, low-tax setups. Paraguay residency, US LLC formation, and tax exit strategy.
      </p>
    </div>

    <!-- Nav -->
    <div>
      <p class="font-heading font-semibold text-cream-100 text-sm mb-3 uppercase tracking-wider">Links</p>
      <nav class="flex flex-col gap-2">
        <a href="/about" class="text-sm text-cream-100/70 hover:text-cream-100 no-underline transition-colors duration-200">About</a>
        <a href="https://nomadtaxhelp.com" target="_blank" rel="noopener noreferrer" class="text-sm text-cream-100/70 hover:text-cream-100 no-underline transition-colors duration-200">Main Site</a>
        <a href={calLink} target="_blank" rel="noopener noreferrer" class="text-sm text-cream-100/70 hover:text-cream-100 no-underline transition-colors duration-200">Book a Call</a>
        <a href="https://instagram.com/nomadtaxhelp_" target="_blank" rel="noopener noreferrer" class="text-sm text-cream-100/70 hover:text-cream-100 no-underline transition-colors duration-200">Instagram</a>
      </nav>
    </div>

    <!-- Contact -->
    <div>
      <p class="font-heading font-semibold text-cream-100 text-sm mb-3 uppercase tracking-wider">Contact</p>
      <a href="mailto:hello@nomadtaxhelp.com" class="text-sm text-cream-100/70 hover:text-cream-100 no-underline transition-colors duration-200">
        hello@nomadtaxhelp.com
      </a>
    </div>
  </div>

  <div class="max-w-[1120px] mx-auto mt-8 pt-6 border-t border-white/10 text-center text-xs text-cream-100/60">
    <p class="mb-1">We're not tax or legal advisers. We work alongside licensed partners who are.</p>
    <p class="text-cream-100/40">&copy; {currentYear} NomadTaxHelp. All rights reserved.</p>
  </div>
</footer>
