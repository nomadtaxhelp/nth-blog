---
const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'All Posts', href: '/posts' },
  { label: 'About', href: '/about' },
];
const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';

const currentPath = Astro.url.pathname;
---

<header id="site-header" class="text-cream-100 sticky top-0 z-50 transition-colors duration-200">
  <div class="max-w-[1200px] mx-auto px-5 sm:px-8 flex items-center justify-between h-16">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 shrink-0 no-underline">
      <span class="font-heading text-xl font-bold tracking-tight text-cream-100">NomadTaxHelp</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-6">
      {navLinks.map((link) => {
        const isActive = link.href === '/' ? currentPath === '/' : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              'text-sm font-heading font-medium text-cream-100 tracking-[0.01em] no-underline transition-colors duration-200 pb-1',
              isActive ? 'border-b-2 border-amber-600' : 'border-b-2 border-transparent hover:text-amber-600',
            ]}
            {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {link.label}
          </a>
        );
      })}
      <a
        href={calLink}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-shimmer inline-flex items-center px-5 py-2 rounded-lg text-sm font-heading font-semibold no-underline"
      >
        Book a Call
      </a>
    </nav>

    <!-- Mobile hamburger -->
    <button
      id="mobile-menu-btn"
      class="md:hidden p-2 text-cream-100"
      aria-label="Toggle menu"
      aria-expanded="false"
    >
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <nav id="mobile-menu" class="hidden md:hidden bg-teal-deep/95 backdrop-blur-sm border-t border-cream-100/10 px-5 pb-4">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block py-3 text-cream-100 hover:text-amber-600 no-underline font-heading text-sm font-medium border-b border-cream-100/10 transition-colors duration-200"
        {...(link.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
      >
        {link.label}
      </a>
    ))}
    <a
      href={calLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-shimmer mt-3 block text-center px-5 py-3 rounded-lg text-sm font-heading font-semibold no-underline"
    >
      Book a Call
    </a>
  </nav>
</header>

<!-- Mobile floating CTA -->
<div class="md:hidden fixed bottom-4 left-4 right-4 z-40">
  <a
    href={calLink}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-shimmer block text-center px-5 py-3 rounded-lg text-sm font-heading font-semibold no-underline shadow-lg"
  >
    Talk to Felix &rarr;
  </a>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    hamburgerIcon?.classList.toggle('hidden', isOpen);
    closeIcon?.classList.toggle('hidden', !isOpen);
  });

  // Header bg: transparent at top, teal-deep/95 with backdrop blur once scrolled.
  const header = document.getElementById('site-header');
  const setHeaderState = () => {
    if (!header) return;
    const scrolled = window.scrollY > 8;
    header.classList.toggle('bg-teal-deep/95', scrolled);
    header.classList.toggle('backdrop-blur-md', scrolled);
    header.classList.toggle('shadow-[0_1px_0_0_rgba(255,228,196,0.08)]', scrolled);
  };
  setHeaderState();
  window.addEventListener('scroll', setHeaderState, { passive: true });
</script>

<style>
  /* Tailwind v4 doesn't auto-emit unused arbitrary class lookups; ensure these
     are kept by referencing them at the same specificity here. */
  #site-header.bg-teal-deep\/95 { background-color: rgb(0 53 54 / 0.95); }
</style>
