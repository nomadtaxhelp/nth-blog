---
// Desktop-only exit intent modal. Fires once per session.
---

<div
  id="exit-intent-modal"
  class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/50"
  role="dialog"
  aria-modal="true"
  aria-label="Content offer"
>
  <div class="bg-white rounded-xl shadow-xl max-w-md mx-4 p-6 sm:p-8 relative">
    <button
      id="exit-intent-close"
      class="absolute top-3 right-3 text-gray-600 hover:text-gray-900 p-1"
      aria-label="Close"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <p class="text-2xl mb-2">📄</p>
    <h3 class="font-heading text-xl font-bold text-teal-900 mb-2">Before you go...</h3>
    <p class="text-sm text-gray-600 mb-4">
      Grab the Paraguay Residency Checklist. Free PDF, covers the full setup process.
    </p>

    <form id="exit-intent-form" class="flex gap-2">
      <input
        type="email"
        name="email"
        placeholder="you@example.com"
        required
        class="flex-1 px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-600"
      />
      <button
        type="submit"
        class="px-4 py-2 rounded-lg bg-amber-600 text-white font-heading font-semibold text-sm hover:bg-amber-700 transition-colors shrink-0"
      >
        Send it to me
      </button>
    </form>
    <p id="exit-intent-success" class="hidden text-sm text-green-600 mt-2">
      Check your email. The PDF is on its way.
    </p>
    <p id="exit-intent-error" class="hidden text-sm text-coral-600 mt-2">
      Something went wrong. Try again.
    </p>
    <button id="exit-intent-dismiss" class="mt-3 text-sm text-gray-600 hover:text-gray-900 underline">
      No thanks
    </button>
  </div>
</div>

<script>
  // Only on desktop, once per session
  if (typeof window !== 'undefined' && window.innerWidth >= 1024) {
    const shown = sessionStorage.getItem('exit-intent-shown');
    if (!shown) {
      document.addEventListener('mouseout', (e) => {
        if (e.clientY <= 0 && !sessionStorage.getItem('exit-intent-shown')) {
          const modal = document.getElementById('exit-intent-modal');
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
          sessionStorage.setItem('exit-intent-shown', 'true');
        }
      });
    }
  }

  const closeModal = () => {
    const modal = document.getElementById('exit-intent-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  };

  document.getElementById('exit-intent-close')?.addEventListener('click', closeModal);
  document.getElementById('exit-intent-dismiss')?.addEventListener('click', closeModal);

  document.getElementById('exit-intent-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeModal();
  });

  const exitForm = document.getElementById('exit-intent-form') as HTMLFormElement | null;
  exitForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const success = document.getElementById('exit-intent-success');
    const error = document.getElementById('exit-intent-error');
    success?.classList.add('hidden');
    error?.classList.add('hidden');

    const email = new FormData(exitForm).get('email') as string;
    try {
      const res = await fetch('/api/subscribe', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, upgradeId: 'paraguay-doc-prep', source: 'exit-intent' }),
      });
      if (res.ok) {
        success?.classList.remove('hidden');
        exitForm.reset();
      } else {
        error?.classList.remove('hidden');
      }
    } catch {
      error?.classList.remove('hidden');
    }
  });
</script>
