---
// Desktop-only exit intent modal. Fires once per session.
// Pushes to clarity call (no email capture, no health check).
const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
---

<div
  id="exit-intent-modal"
  class="hidden fixed inset-0 z-[100] items-center justify-center bg-black/50"
  role="dialog"
  aria-modal="true"
  aria-label="Book a clarity call"
>
  <div class="bg-white rounded-xl shadow-xl max-w-md mx-4 p-6 sm:p-8 relative text-center">
    <button
      id="exit-intent-close"
      class="absolute top-3 right-3 text-gray-600 hover:text-gray-900 p-1"
      aria-label="Close"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <p class="text-3xl mb-3">📞</p>
    <h3 class="font-heading text-xl font-bold text-teal-900 mb-2">Hold up.</h3>
    <p class="text-sm text-gray-600 mb-5 max-w-xs mx-auto">
      20 mins on the phone with me. I'll find what's leaking in your setup. No pitch.
    </p>

    <a
      href={calLink}
      target="_blank"
      rel="noopener noreferrer"
      id="exit-intent-cta"
      class="btn-shimmer inline-flex items-center px-6 py-3 rounded-full font-heading font-semibold no-underline"
    >
      Book a free call &rarr;
    </a>

    <button id="exit-intent-dismiss" class="block mx-auto mt-4 text-sm text-gray-600 hover:text-gray-900 underline">
      Maybe later
    </button>
  </div>
</div>

<script>
  // Only on desktop, once per session.
  if (typeof window !== 'undefined' && window.innerWidth >= 1024) {
    const shown = sessionStorage.getItem('exit-intent-shown');
    if (!shown) {
      document.addEventListener('mouseout', (e) => {
        if (e.clientY <= 0 && !sessionStorage.getItem('exit-intent-shown')) {
          const modal = document.getElementById('exit-intent-modal');
          modal?.classList.remove('hidden');
          modal?.classList.add('flex');
          sessionStorage.setItem('exit-intent-shown', 'true');
        }
      });
    }
  }

  const closeModal = () => {
    const modal = document.getElementById('exit-intent-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  };

  document.getElementById('exit-intent-close')?.addEventListener('click', closeModal);
  document.getElementById('exit-intent-dismiss')?.addEventListener('click', closeModal);

  // Click on the CTA also closes the modal so the page is clean when they return.
  document.getElementById('exit-intent-cta')?.addEventListener('click', () => {
    setTimeout(closeModal, 150);
  });

  document.getElementById('exit-intent-modal')?.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeModal();
  });
</script>
