---
const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
---

<div class="mt-12 surface-cream p-7 sm:p-9 text-center" style="box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4);">
  <p class="font-heading text-amber-600 text-xs font-semibold uppercase tracking-[0.18em] mb-3">
    Need help with your tax setup?
  </p>
  <h3 class="font-heading text-2xl sm:text-3xl font-bold text-teal-900 mb-3 tracking-[-0.01em]">
    Book a free 20-minute clarity call
  </h3>
  <p class="text-teal-900/75 mb-6 max-w-md mx-auto font-body">
    We can have a 1-1 call, explore your situation and point you towards a more tax-efficient setup.
  </p>
  <a
    href={calLink}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-shimmer inline-flex items-center px-7 py-3.5 font-heading font-semibold no-underline"
    style="border-radius: 0.625rem;"
  >
    Let's Chat ☎️
  </a>
</div>
