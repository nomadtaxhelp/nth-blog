---
const calLink = 'https://nomadtaxhelp.com/call';
const masterclassLink = 'https://nomadtaxhelp.com/4';
---

<div class="mt-12 surface-cream p-7 sm:p-9 text-center" style="box-shadow: 0 14px 30px -12px rgba(0,0,0,0.4);">
  <p class="font-heading text-amber-600 text-xs font-semibold uppercase tracking-[0.18em] mb-3">
    Need help with your tax setup?
  </p>
  <h3 class="font-heading text-2xl sm:text-3xl font-bold text-teal-900 mb-3 tracking-[-0.01em]">
    Have our team handle your Paraguay setup
  </h3>
  <p class="text-teal-900/75 mb-6 max-w-md mx-auto font-body">
    Book a 40-minute consultation with an expert for $67 to discuss your plans and our residency, company and banking support. You choose your call time straight after paying.
  </p>
  <a
    href={calLink}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-shimmer inline-flex items-center px-7 py-3.5 font-heading font-semibold no-underline"
    style="border-radius: 0.625rem;"
  >
    Book your consultation for $67
  </a>
  <p class="mt-4 text-sm text-teal-900/75 font-body">Prefer to do it yourself? <a href={masterclassLink} class="text-teal-900 underline">Start with the $17 masterclass.</a></p>
</div>
