---
interface Props {
  upgradeId: string;
  title: string;
  description: string;
}

const { upgradeId, title, description } = Astro.props;
---

<aside class="bg-cream-50 border border-gray-200 rounded-xl p-5 sm:p-6 my-8">
  <p class="text-xl mb-2">📄</p>
  <p class="font-heading font-semibold text-teal-900 text-lg mb-1">{title}</p>
  <p class="text-sm text-gray-600 mb-3">{description}</p>
  <form class="content-upgrade-form flex gap-2" data-upgrade-id={upgradeId}>
    <input
      type="email"
      name="email"
      placeholder="you@example.com"
      required
      class="flex-1 px-3 py-2 rounded-lg border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-amber-600"
    />
    <button
      type="submit"
      class="px-4 py-2 rounded-lg bg-amber-600 text-white font-heading font-semibold text-sm hover:bg-amber-700 transition-colors shrink-0"
    >
      Send it to me
    </button>
  </form>
  <p class="content-upgrade-success hidden text-sm text-green-600 mt-2">Check your email. The guide is on its way.</p>
  <p class="content-upgrade-error hidden text-sm text-coral-600 mt-2">Something went wrong. Try again.</p>
</aside>

<script>
  document.querySelectorAll('.content-upgrade-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const f = e.target as HTMLFormElement;
      const success = f.parentElement?.querySelector('.content-upgrade-success');
      const error = f.parentElement?.querySelector('.content-upgrade-error');
      success?.classList.add('hidden');
      error?.classList.add('hidden');

      const email = new FormData(f).get('email') as string;
      const upgradeId = f.dataset.upgradeId;

      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, upgradeId, source: 'content-upgrade' }),
        });
        if (res.ok) {
          success?.classList.remove('hidden');
          f.reset();
        } else {
          error?.classList.remove('hidden');
        }
      } catch {
        error?.classList.remove('hidden');
      }
    });
  });
</script>
