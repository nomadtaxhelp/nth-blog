---
const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
---

<div class="space-y-6">
  <!-- Clarity call card -->
  <div class="bg-cream-50 rounded-xl border border-gray-200 p-5">
    <p class="text-lg mb-1">📞</p>
    <p class="font-heading font-semibold text-teal-900 text-sm mb-2">Free 20-min clarity call</p>
    <p class="text-sm text-gray-600 mb-3">
      Map your situation, flag the risks, walk away with a one-page plan.
    </p>
    <a
      href={calLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-shimmer inline-flex items-center px-4 py-2 rounded-full font-heading font-semibold text-xs no-underline"
    >
      Book a call &rarr;
    </a>
  </div>

  <!-- Most popular placeholder -->
  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <p class="font-heading font-semibold text-teal-900 text-sm uppercase tracking-wider mb-3">Popular posts</p>
    <p class="text-sm text-gray-600 italic">More posts coming soon.</p>
  </div>
</div>
