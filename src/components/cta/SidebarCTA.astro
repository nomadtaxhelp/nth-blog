---
const healthCheckLink = 'https://nomadtaxhelp.com/health-check';
---

<div class="space-y-6">
  <!-- Health Check card -->
  <div class="bg-cream-50 rounded-xl border border-gray-200 p-5">
    <p class="text-lg mb-1">✅</p>
    <p class="font-heading font-semibold text-teal-900 text-sm mb-2">Tax Residency Health Check</p>
    <p class="text-sm text-gray-600 mb-3">
      Free 2-minute assessment. Find out where your setup has gaps.
    </p>
    <a
      href={healthCheckLink}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center px-4 py-2 rounded-full bg-amber-600 text-white font-heading font-semibold text-xs no-underline hover:bg-amber-700 transition-colors"
    >
      Take the Health Check &rarr;
    </a>
  </div>

  <!-- Most popular placeholder -->
  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <p class="font-heading font-semibold text-teal-900 text-sm uppercase tracking-wider mb-3">Popular posts</p>
    <p class="text-sm text-gray-600 italic">More posts coming soon.</p>
  </div>
</div>
