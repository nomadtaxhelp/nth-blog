---
const calLink = 'https://cal.com/nomadtaxhelp/clarity-call';
---

<div class="space-y-5">
  <!-- Clarity call card (cream on teal) -->
  <div class="bg-cream-100 text-teal-900 p-5" style="border-radius: 0.625rem; box-shadow: 0 8px 20px -10px rgba(0,0,0,0.3);">
    <p class="font-heading text-amber-600 text-[10px] font-semibold uppercase tracking-[0.15em] mb-2">Need help with your tax setup?</p>
    <p class="text-sm text-teal-900/85 mb-4 font-body leading-relaxed">
      We can have a 1-1 call, explore your situation and point you towards a more tax-efficient setup.
    </p>
    <a
      href={calLink}
      target="_blank"
      rel="noopener noreferrer"
      class="btn-shimmer inline-flex items-center px-4 py-2 font-heading font-semibold text-xs no-underline"
      style="border-radius: 0.5rem;"
    >
      Let's Chat ☎️
    </a>
  </div>

  <!-- Popular placeholder (surface-muted on teal) -->
  <div class="surface-muted p-5">
    <p class="font-heading font-semibold text-cream-100 text-xs uppercase tracking-[0.15em] mb-3">Popular posts</p>
    <p class="text-sm text-cream-soft/70 italic font-body">More posts coming soon.</p>
  </div>
</div>
