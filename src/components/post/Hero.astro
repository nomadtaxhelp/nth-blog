---
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<div class="bg-cream-100 py-16 sm:py-20 px-4">
  <div class="max-w-[680px] mx-auto text-center">
    <h1 class="font-heading text-3xl sm:text-4xl font-bold text-teal-900 mb-4">{title}</h1>
    {subtitle && (
      <p class="font-body text-lg text-gray-600">{subtitle}</p>
    )}
  </div>
</div>
