---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside
  class="surface-muted border-l-4 border-amber-600 p-5 sm:p-6 mb-6"
  style="border-radius: 0 0.625rem 0.625rem 0;"
  data-answer-capsule="true"
>
  <p class="font-heading text-amber-600 text-xs font-semibold uppercase tracking-[0.15em] mb-2">
    The short answer
  </p>
  <p class="text-base leading-relaxed text-cream-soft m-0 font-body">{text}</p>
</aside>
