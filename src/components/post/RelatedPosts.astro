---
import type { CollectionEntry } from 'astro:content';
import CategoryPill from '../ui/CategoryPill.astro';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;

const categoryLabels: Record<string, string> = {
  'paraguay': 'Paraguay',
  'tax-residency': 'Tax Residency',
  'us-llc': 'US LLC',
};
---

<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {posts.slice(0, 3).map((post) => (
    <a
      href={`/posts/${post.data.slug}`}
      class="block p-5 bg-cream-100 text-teal-900 no-underline group transition-all duration-200 hover:-translate-y-0.5"
      style="border-radius: 0.625rem; border: 1px solid rgba(205, 126, 17, 0.2); box-shadow: 0 8px 20px -10px rgba(0,0,0,0.3);"
    >
      <CategoryPill
        category={post.data.category}
        label={categoryLabels[post.data.category] || post.data.category}
        size="sm"
      />
      <h3 class="font-heading font-bold text-teal-900 text-base mt-3 mb-2 group-hover:text-amber-700 transition-colors leading-snug">
        {post.data.title}
      </h3>
      <p class="text-sm text-teal-900/75 line-clamp-2 font-body leading-relaxed">{post.data.description}</p>
    </a>
  ))}
</div>
