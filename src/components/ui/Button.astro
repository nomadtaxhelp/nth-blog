---
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  external?: boolean;
}

const { href, variant = 'primary', size = 'md', external = false } = Astro.props;

const baseClasses = 'inline-flex items-center font-heading font-semibold no-underline transition-colors rounded-full';

const variantClasses = {
  primary: 'bg-amber-600 text-white hover:bg-amber-700',
  ghost: 'border-2 border-teal-900 text-teal-900 hover:bg-teal-900 hover:text-white',
};

const sizeClasses = {
  sm: 'px-4 py-1.5 text-xs',
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-6 py-3 text-base',
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]}`;
---

<a
  href={href}
  class={classes}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
